@model IEnumerable<_UPDATED__FrontEnd_Capstone.Models.Vendor>
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=1440, initial-scale=1.0">
    <title>J-Hub | Vendor Management</title>
    <style>
        :root {
            --bg-primary: #0f172a; --bg-secondary: #1e293b; --border-color: #334155;
            --text-primary: #ffffff; --text-muted: #94a3b8; --accent-blue: #3b82f6; --status-nogo: #ef4444;
        }
        body { margin: 0; padding: 0; box-sizing: border-box; background-color: var(--bg-primary); font-family: system-ui, sans-serif; color: var(--text-primary); }
        .dashboard-layout { display: grid; grid-template-columns: 250px 1fr; height: 100vh; overflow: hidden; }
        .sidebar { background-color: var(--bg-secondary); padding: 24px; border-right: 1px solid var(--border-color); display: flex; flex-direction: column; }
        .main-content { padding: 32px; overflow-y: auto; background-color: var(--bg-primary); }
        .data-table { width: 100%; border-collapse: collapse; background-color: var(--bg-secondary); border-radius: 8px; overflow: hidden; }
        .data-table th, .data-table td { text-align: left; padding: 16px; border-bottom: 1px solid var(--border-color); }
        .data-table th { background-color: rgba(0,0,0,0.2); font-size: 12px; letter-spacing: 0.05em; color: var(--text-muted); }
        .heading-xl { font-size: 28px; font-weight: 700; margin: 0; }
        .heading-md { font-size: 15px; font-weight: 600; margin: 0; }
        .body-text { font-size: 14px; line-height: 1.5; margin: 0; }
        .label-text { font-size: 12px; font-weight: 600; color: var(--text-muted); letter-spacing: 0.5px; }
        .brand-logo { display: flex; align-items: center; gap: 10px; margin-bottom: 32px; }
        .logo-text { font-size: 20px; font-weight: 800; color: #ffffff; }
        .btn { padding: 10px 20px; border-radius: 8px; font-size: 14px; font-weight: 600; cursor: pointer; border: none; transition: opacity 0.2s; }
        .btn-primary { background-color: #2563eb; color: white; }
        .btn-danger { background-color: var(--status-nogo); color: white; padding: 6px 12px; font-size: 12px; }
        .input-field { background-color: var(--bg-primary); border: 1px solid var(--border-color); color: var(--text-primary); padding: 10px 14px; border-radius: 6px; font-size: 14px; width: 100%; box-sizing: border-box; margin-top: 6px; margin-bottom: 12px; }
        .modal-overlay { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.7); z-index: 1000; justify-content: center; align-items: center; }
        .modal-card { background: var(--bg-secondary); padding: 32px; border-radius: 12px; width: 400px; }
    </style>
</head>
<body>
    <div class="dashboard-layout">
        <aside class="sidebar">
            <div class="brand-logo">
                <span class="logo-text">J-Hub <span style="font-size: 14px; font-weight: 500; color: var(--text-muted); vertical-align: middle; margin-left: 4px;">Operator</span></span>
            </div>
            <nav style="display: flex; flex-direction: column; gap: 16px; height: 100%;">
                <a href="/Home/OperatorDashboard" class="body-text" style="color: var(--text-muted); text-decoration: none;">Dashboard</a>
                <a href="/Tour/Management" class="body-text" style="color: var(--text-muted); text-decoration: none;">Tour Management</a>
                <a href="/User/BookingQueue" class="body-text" style="color: var(--text-muted); text-decoration: none;">Booking Queue</a>
                <a href="/Vendor/Management" class="body-text" style="color: var(--text-primary); font-weight: 600; text-decoration: none;">Vendors</a>
                <a href="/User/UserManagement" class="body-text" style="color: var(--text-muted); text-decoration: none;">User Management (RBAC)</a>
                <a href="/Home/Login" class="body-text" style="color: var(--status-nogo); text-decoration: none; font-weight: 500; margin-top: auto;">Log Out</a>
            </nav>
        </aside>

        <main class="main-content">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
                <h1 class="heading-xl">Vendor Management</h1>
                <button onclick="document.getElementById('add-modal').style.display='flex'" class="btn btn-primary">+ Add New Vendor</button>
            </div>
            <table class="data-table">
                <thead>
                    <tr>
                        <th class="label-text">NAME</th>
                        <th class="label-text">TYPE</th>
                        <th class="label-text">CONTACT INFO</th>
                        <th class="label-text">PAYMENT TERMS</th>
                        <th class="label-text">PAYABLES (PHP)</th>
                        <th class="label-text">STATUS</th>
                        <th class="label-text">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any()) {
                        @foreach (var v in Model) {
                            <tr>
                                <td class="heading-md">@v.VendorName</td>
                                <td class="body-text">@v.ServiceType</td>
                                <td class="body-text">@v.ContactInfo</td>
                                <td class="body-text">@v.PaymentTerms</td>
                                <td class="body-text" style="font-weight: 600; color: #f43f5e;">₱@v.Payables.ToString("N2")</td>
                                <td class="body-text">@v.Status</td>
                                <td>
                                    <form action="/Vendor/Delete" method="POST" onsubmit="return confirm('Delete this vendor?');" style="margin:0;">
                                        <input type="hidden" name="id" value="@v.Id" />
                                        <button type="submit" class="btn btn-danger">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    } else {
                        <tr><td colspan="7" class="body-text" style="text-align: center; color: var(--text-muted); padding: 32px;">No vendors found.</td></tr>
                    }
                </tbody>
            </table>
        </main>
    </div>

    <div id="add-modal" class="modal-overlay">
        <div class="modal-card">
            <h2 class="heading-md" style="margin-bottom: 20px;">Add New Vendor</h2>
            <form action="/Vendor/Create" method="POST">
                <label class="label-text">Vendor Name</label>
                <input name="vendorName" class="input-field" required>
                <label class="label-text">Service Type</label>
                <select name="serviceType" class="input-field">
                    <option value="Transport">Transport</option>
                    <option value="Accommodation">Accommodation</option>
                    <option value="Tour Guide">Tour Guide</option>
                </select>
                <label class="label-text">Contact Info</label>
                <input name="contactInfo" class="input-field" required>
                <label class="label-text">Payment Terms</label>
                <input name="paymentTerms" class="input-field" required>
                <label class="label-text">Initial Payables Amount (PHP)</label>
                <input type="text" id="payables-masked" class="input-field" required placeholder="0.00">
                <input type="hidden" name="payables" id="payables-pure" value="0.00">
                <input type="hidden" name="status" value="Active">
                <button type="submit" class="btn btn-primary" style="width: 100%;">Save Vendor</button>
                <button type="button" onclick="document.getElementById('add-modal').style.display='none'" class="btn" style="width: 100%; margin-top: 8px; background: transparent; color: var(--text-muted);">Cancel</button>
            </form>
        </div>
    </div>
    <script>
        const maskedInput = document.getElementById('payables-masked');
        const pureInput = document.getElementById('payables-pure');
        maskedInput.addEventListener('input', function (e) {
            let val = e.target.value.replace(/[^0-9.]/g, '');
            let parts = val.split('.');
            if (parts.length > 2) val = parts[0] + '.' + parts[1];
            let displayVal = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ",");
            if(parts.length > 1) displayVal += "." + parts[1];
            e.target.value = displayVal;
        });
        maskedInput.addEventListener('blur', function (e) {
            let cleanValue = e.target.value.replace(/,/g, '');
            let num = parseFloat(cleanValue);
            if (!isNaN(num)) {
                pureInput.value = num.toFixed(2);
                maskedInput.value = num.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            } else {
                pureInput.value = "0.00";
                maskedInput.value = "";
            }
        });
    </script>
</body>
</html>
