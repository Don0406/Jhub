@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>J-Hub | Welcome</title>
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
    <style>
        body {
            margin: 0;
            padding: 0;
            background-color: #0b1120;
            color: #ffffff;
            font-family: sans-serif;
        }
        .navbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 24px 64px;
            background-color: #0b1120;
        }
        .hero-section {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            height: calc(100vh - 85px);
            padding: 0 24px;
            background: linear-gradient(180deg, #0b1120 0%, #1e293b 100%);
        }
        .hero-title {
            font-size: 64px;
            font-weight: 700;
            margin-bottom: 24px;
            background: linear-gradient(90deg, #F8FAFC, #3b82f6);
            background-clip: text;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
    </style>
</head>
<body>

    <nav class="navbar">
        <div class="brand-logo" style="display: flex; align-items: center; gap: 10px;">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                <line x1="12" y1="22.08" x2="12" y2="12"></line>
            </svg>
            <span class="logo-text" style="font-weight: 700; font-size: 20px;">J-Hub</span>
        </div>
        <div style="display: flex; gap: 16px;">
            <a asp-controller="Home" asp-action="Login"><button class="btn btn-secondary" style="padding: 8px 16px; background: transparent; color: #fff; border: 1px solid #334155; border-radius: 6px; cursor: pointer;">Log In</button></a>
            <a asp-controller="Home" asp-action="Register"><button class="btn btn-primary" style="padding: 8px 16px; background: #3b82f6; color: #fff; border: none; border-radius: 6px; cursor: pointer;">Sign Up</button></a>
        </div>
    </nav>

    <main class="hero-section">
        <h1 class="hero-title">The Operating System for Shared Travel</h1>
        <p style="color: #94a3b8; max-width: 600px; margin-bottom: 40px; line-height: 1.5; font-size: 18px;">
            J-Hub intelligently matches joiners, manages tour operator financials, and equips field staff with real-time digital manifests.
        </p>
        <div style="display: flex; gap: 16px;">
            <a asp-controller="Booking" asp-action="TourDiscovery"><button style="padding: 16px 32px; font-size: 16px; background: #3b82f6; color: #fff; border: none; border-radius: 6px; cursor: pointer;">Browse Tours</button></a>
        </div>
    </main>

</body>
</html>