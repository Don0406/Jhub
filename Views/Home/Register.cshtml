@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>J-Hub | Registration</title>
    <style>
        /* Selyadong Base Core Styles at Variables */
        :root {
            --bg-primary: #0f172a;    /* Slate 900 */
            --bg-secondary: #1e293b;  /* Slate 800 */
            --border-color: #334155;  /* Slate 700 */
            --text-muted: #94a3b8;    /* Slate 400 */
            --accent-blue: #3b82f6;   /* Blue 500 */
        }

        body {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            background-color: var(--bg-primary);
            font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            color: #ffffff;
        }

        .auth-container {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            background-color: var(--bg-primary);
            padding: 40px 20px;
        }

        .auth-card {
            background-color: var(--bg-secondary);
            padding: 40px;
            border-radius: 12px;
            width: 100%;
            max-width: 500px;
            border: 1px solid var(--border-color);
            box-shadow: 0 10px 25px rgba(0,0,0,0.5);
        }

        .heading-lg {
            color: #ffffff;
            font-size: 32px;
            font-weight: 800;
            letter-spacing: -0.5px;
        }

        .body-text {
            font-size: 14px;
            color: #ffffff;
        }

        .grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }

        .label-text {
            font-size: 14px;
            font-weight: 500;
            color: #cbd5e1; /* Slate 300 */
        }

        /* Pinilit na Overwrite para sa Input Fields mo */
        .input-field {
            width: 100%;
            padding: 12px 16px;
            background-color: #0f172a !important; /* Slate 900 */
            border: 1px solid #475569 !important; /* Slate 600 */
            border-radius: 8px;
            color: #ffffff !important;
            font-size: 15px;
            transition: border-color 0.2s;
            box-sizing: border-box;
        }

        .input-field:focus {
            outline: none;
            border-color: var(--accent-blue) !important;
        }

        select.input-field {
            color: #ffffff !important;
            background-color: #0f172a !important;
        }

        /* Pinilit na Overwrite para sa Register Button mo */
        .btn-primary {
            width: 100%;
            background-color: #2563eb !important; /* Blue 600 */
            color: #ffffff !important;
            border: none;
            padding: 14px;
            border-radius: 8px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: background-color 0.2s;
        }

        .btn-primary:hover {
            background-color: #1d4ed8 !important; /* Blue 700 */
        }
    </style>
</head>
<body>
    <div class="auth-container">
        <div class="auth-card">
            <h1 class="heading-lg" style="text-align: center; margin-bottom: 8px;">Create an Account</h1>
            <p class="body-text" style="text-align: center; color: var(--text-muted); margin-bottom: 32px;">Join J-Hub to access your operations dashboard.</p>
            
            @if (ViewBag.ErrorMessage != null)
            {
                <div style="background-color: rgba(239, 68, 68, 0.15); color: #f87171; padding: 12px; border-radius: 8px; margin-bottom: 20px; font-size: 14px; text-align: center; border: 1px solid rgba(239, 68, 68, 0.4);">
                    @ViewBag.ErrorMessage
                </div>
            }

            <form id="register-form" method="POST" action="/Home/Register">
                
                <input type="hidden" name="confirmPassword" value="auto-match" id="confirm-password-hidden" />

                <div style="margin-bottom: 16px;">
                    <label class="label-text">Full Name</label>
                    <input type="text" id="full-name" name="fullName" class="input-field" placeholder="Juan Dela Cruz" required style="margin-top: 8px;">
                </div>

                <div class="grid-2" style="margin-bottom: 16px;">
                    <div>
                        <label class="label-text">Email Address</label>
                        <input type="email" name="email" class="input-field" placeholder="name@example.com" required style="margin-top: 8px;">
                    </div>
                    <div>
                        <label class="label-text">Phone Number</label>
                        <input type="tel" name="phoneNumber" class="input-field" placeholder="09XX XXX XXXX" required style="margin-top: 8px;">
                    </div>
                </div>

                <div class="grid-2" style="margin-bottom: 16px;">
                    <div>
                        <label class="label-text">Sex</label>
                        <select name="sex" class="input-field" required style="margin-top: 8px;">
                            <option value="" disabled selected>Select...</option>
                            <option value="male">Male</option>
                            <option value="female">Female</option>
                        </select>
                    </div>
                    <div>
                        <label class="label-text">Age</label>
                        <input type="number" name="age" class="input-field" placeholder="e.g. 24" min="18" max="100" required style="margin-top: 8px;">
                    </div>
                </div>

                <div class="grid-2" style="margin-bottom: 32px;">
                    <div>
                        <label class="label-text">Account Type</label>
                        <select name="role" class="input-field" required style="margin-top: 8px;">
                            <option value="" disabled selected>Select position...</option>
                            <option value="operator">Main Tour Operator</option>
                            <option value="admin">System Admin</option>
                        </select>
                    </div>
                    <div>
                        <label class="label-text">Password</label>
                        <input type="password" name="password" id="main-password" class="input-field" placeholder="••••••••" required style="margin-top: 8px;">
                    </div>
                </div>
                
                <button type="submit" class="btn-primary" style="margin-bottom: 16px;">Register</button>
            </form>
            
            <p class="body-text" style="text-align: center; color: var(--text-muted);">
                Already have an account? <a asp-controller="Home" asp-action="Login" style="color: var(--accent-blue); text-decoration: none; font-weight: 500;">Log In</a>
            </p>
        </div>
    </div>

    <script>
        document.getElementById('register-form').addEventListener('submit', function() {
            var pass = document.getElementById('main-password').value;
            document.getElementById('confirm-password-hidden').value = pass;
        });
    </script>
</body>
</html>
