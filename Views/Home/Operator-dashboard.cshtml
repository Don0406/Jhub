@model IEnumerable<_UPDATED__FrontEnd_Capstone.Models.Tour>
@{
    Layout = null;
    var allTours = Model ?? Enumerable.Empty<_UPDATED__FrontEnd_Capstone.Models.Tour>();
    var activeTours = allTours.Where(x => x.Status != "Archived" && !x.IsComplete && !x.IsCancelled).ToList();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=1440, initial-scale=1.0">
    <title>J-Hub | Operator Command Center</title>
    <style>
        :root {
            --bg-primary: #0f172a;
            --bg-secondary: #1e293b;
            --border-color: #334155;
            --text-primary: #ffffff;
            --text-muted: #94a3b8;
            --accent-blue: #3b82f6;
            --status-go: #22c55e;
            --status-watch: #eab308;
            --status-nogo: #ef4444;
        }

        body { margin: 0; padding: 0; box-sizing: border-box; background-color: var(--bg-primary); font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; color: var(--text-primary); }
        .dashboard-layout { display: grid; grid-template-columns: 250px 1fr 350px; height: 100vh; overflow: hidden; }
        .sidebar { background-color: var(--bg-secondary); padding: 24px; border-right: 1px solid var(--border-color); display: flex; flex-direction: column; }
        .main-content { padding: 32px; overflow-y: auto; background-color: var(--bg-primary); }
        
        .analytics-panel { 
            background-color: var(--bg-secondary); 
            padding: 24px; 
            border-left: 1px solid var(--border-color); 
            display: flex; 
            flex-direction: column; 
            gap: 20px; 
            height: 100vh;
            overflow-y: auto; 
            box-sizing: border-box;
        }
        
        .analytics-panel::-webkit-scrollbar { width: 6px; }
        .analytics-panel::-webkit-scrollbar-track { background: var(--bg-secondary); }
        .analytics-panel::-webkit-scrollbar-thumb { background: var(--border-color); border-radius: 4px; }

        .data-table { width: 100%; border-collapse: collapse; background-color: var(--bg-secondary); border-radius: 8px; overflow: hidden; }
        .data-table th, .data-table td { text-align: left; padding: 16px; border-bottom: 1px solid var(--border-color); }
        .data-table th { background-color: rgba(0,0,0,0.2); font-size: 12px; letter-spacing: 0.05em; color: var(--text-muted); }

        .heading-xl { font-size: 28px; font-weight: 700; margin: 0; }
        .heading-md { font-size: 15px; font-weight: 600; margin: 0; }
        .body-text { font-size: 14px; line-height: 1.5; margin: 0; }
        .label-text { font-size: 12px; font-weight: 600; color: var(--text-muted); letter-spacing: 0.5px; }
        .brand-logo { display: flex; align-items: center; gap: 10px; margin-bottom: 32px; }
        .logo-text { font-size: 20px; font-weight: 800; color: #ffffff; }

        .btn { padding: 8px 16px; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer; border: none; transition: opacity 0.2s; display: inline-block; text-align: center; text-decoration: none; }
        .btn-primary { background-color: #2563eb; color: white; }
        .btn-secondary { background-color: #475569; color: white; padding: 6px 12px; font-size: 12px; }
        .btn-danger-soft { background-color: rgba(239, 68, 68, 0.15); color: var(--status-nogo); border: 1px solid rgba(239, 68, 68, 0.3); }

        .badge { padding: 4px 8px; border-radius: 4px; font-size: 12px; font-weight: 600; display: inline-block; }
        .bg-go { background-color: rgba(34, 197, 94, 0.2); color: var(--status-go); }
        .bg-watch { background-color: rgba(234, 179, 8, 0.2); color: var(--status-watch); }
        .bg-nogo { background-color: rgba(239, 68, 68, 0.2); color: var(--status-nogo); }
        .bg-full { background-color: rgba(59, 130, 246, 0.2); color: var(--accent-blue); }

        /* Techy Booking Velocity Style */
        .velocity-techy {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(59, 130, 246, 0.1);
            border: 1px solid rgba(59, 130, 246, 0.3);
            color: #60a5fa;
            padding: 4px 10px;
            border-radius: 6px;
            font-family: monospace;
            font-size: 13px;
            font-weight: 600;
            box-shadow: 0 0 10px rgba(59, 130, 246, 0.1);
        }
        .velocity-techy::before {
            content: '';
            width: 6px;
            height: 6px;
            background-color: #3b82f6;
            border-radius: 50%;
            display: inline-block;
            box-shadow: 0 0 6px #3b82f6;
        }

        .alert-card-low { background-color: var(--bg-primary); padding: 16px; border-radius: 8px; border: 1px solid rgba(234, 179, 8, 0.3); border-left: 4px solid var(--status-watch); margin-bottom: 12px; }
        .alert-card-med { background-color: var(--bg-primary); padding: 16px; border-radius: 8px; border: 1px solid rgba(249, 115, 22, 0.4); border-left: 4px solid #f97316; margin-bottom: 12px; }
        .alert-card-high { background-color: var(--bg-primary); padding: 16px; border-radius: 8px; border: 1px solid rgba(239, 68, 68, 0.4); border-left: 4px solid var(--status-nogo); margin-bottom: 12px; }
        
        /* Individual Tour Velocity Graph Component */
        .velocity-graph-container {
            background-color: var(--bg-secondary);
            padding: 20px;
            border-radius: 8px;
            border: 1px solid var(--border-color);
            display: flex;
            flex-direction: column;
            gap: 16px;
        }
        .graph-row {
            background-color: var(--bg-primary);
            padding: 12px 16px;
            border-radius: 6px;
            border: 1px solid var(--border-color);
        }
        .graph-meta {
            display: flex;
            justify-content: space-between;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 8px;
        }
        .graph-track {
            background-color: #020617;
            height: 10px;
            border-radius: 6px;
            overflow: hidden;
            border: 1px solid var(--border-color);
            position: relative;
        }
        .graph-bar {
            height: 100%;
            border-radius: 6px;
            transition: width 0.4s ease;
            width: 0%;
        }
        .bar-high { background-color: var(--status-go); box-shadow: 0 0 8px rgba(34, 197, 94, 0.4); }
        .bar-med { background-color: #f97316; box-shadow: 0 0 8px rgba(249, 115, 22, 0.4); }
        .bar-low { background-color: var(--status-watch); box-shadow: 0 0 8px rgba(234, 179, 8, 0.4); }
    </style>
</head>
<body>
    <div class="dashboard-layout">
        <!-- SIDEBAR -->
        <aside class="sidebar">
            <div class="brand-logo">
                <span class="logo-text">J-Hub <span style="font-size: 14px; font-weight: 500; color: var(--text-muted); vertical-align: middle; margin-left: 4px;">Operator</span></span>
            </div>
            <nav style="display: flex; flex-direction: column; gap: 16px; height: 100%;">
                <a href="/Home/OperatorDashboard" class="body-text" style="color: var(--text-primary); font-weight: 600; text-decoration: none;">Dashboard</a>
                <a href="/Tour/Management" class="body-text" style="color: var(--text-muted); text-decoration: none;">Tour Management</a>
                <a href="/User/BookingQueue" class="body-text" style="color: var(--text-muted); text-decoration: none;">Booking Queue</a>
                <a href="/Tour/VendorManagement" class="body-text" style="color: var(--text-muted); text-decoration: none;">Vendors</a>
                <a href="/Home/Logout" class="body-text" style="color: var(--status-nogo); text-decoration: none; font-weight: 500; margin-top: auto;">Log Out</a>
            </nav>
        </aside>

        <!-- MAIN CONTENT -->
        <main class="main-content">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
                <h1 class="heading-xl">Current Tours</h1>
                <a href="/User/BookingQueue" class="btn btn-primary">Open Booking Queue</a>
            </div>

            <table class="data-table">
                <thead>
                    <tr>
                        <th class="label-text">TOUR NAME / DESTINATION</th>
                        <th class="label-text">SLOTS FILLED</th>
                        <th class="label-text">Predicted Booking Velocity</th>
                        <th class="label-text">SYSTEM STATUS</th>
                        <th class="label-text">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null) {
                        @foreach (var t in activeTours) {
                            var status = (ViewBag.TourStatuses != null && ViewBag.TourStatuses.ContainsKey(t.Id)) ? ViewBag.TourStatuses[t.Id] : "WATCH";
                            string css = status == "NO-GO" ? "bg-nogo" : (status == "FULL" ? "bg-full" : (status == "GO" ? "bg-go" : "bg-watch"));
                            
                            <tr>
                                <td class="heading-md">@t.TourName</td>
                                <td class="body-text">@t.SlotsFilled / @t.TotalCapacity</td>
                                <td><span id="velocity-@t.Id" class="velocity-techy">Loading...</span></td>
                                <td><span class="badge @css">@status</span></td>
                                <td><a href="/Tour/Management" class="btn btn-secondary">View</a></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

            <!-- INDIVIDUAL TOUR BOOKING VELOCITY BARS -->
            <div style="margin-top: 32px;">
                <h3 class="heading-md" style="margin-bottom: 16px;"> Tour Fill Rate & Velocity Performance</h3>
                <div class="velocity-graph-container" id="velocity-container">
                    @if (activeTours != null && activeTours.Any())
                    {
                        @foreach (var t in activeTours)
                        {
                            <div class="graph-row" id="graph-row-@t.Id">
                                <div class="graph-meta">
                                    <span style="font-weight: 700; color: var(--text-primary);">@t.TourName</span>
                                    <span id="graph-label-@t.Id" style="color: var(--text-muted); font-family: monospace;">Calculating fill rate...</span>
                                </div>
                                <div class="graph-track">
                                    <div id="graph-bar-@t.Id" class="graph-bar" style="width: 0%;"></div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="body-text" style="color: var(--text-muted); text-align: center; padding: 12px;">No active tours available for graph analysis.</p>
                    }
                </div>
            </div>

        </main>

        <!-- RIGHT SIDEBAR: ANALYTICS & PREDICTIVE INSIGHTS -->
        <aside class="analytics-panel">
            <div>
                <h3 class="heading-md" style="margin-bottom: 16px;">Financial Analytics</h3>
                <div style="background-color: var(--bg-primary); padding: 16px; border-radius: 8px; border: 1px solid var(--border-color);">
                    <p class="label-text">TOTAL OPERATIONAL COSTS</p>
                    <p id="operational-cost-display" style="font-size: 24px; font-weight: 700; color: var(--status-go); margin: 4px 0 0 0;">Loading...</p>
                </div>
            </div>

            <div>
                <h3 class="heading-md" style="margin-bottom: 16px;">Cancellation Risk Insights</h3>
                
                @if (ViewBag.HasAnyRisk != null && (bool)ViewBag.HasAnyRisk)
                {
                    @if (ViewBag.LowRiskList != null && ((List<string>)ViewBag.LowRiskList).Any())
                    {
                        <div class="alert-card-low">
                            <p class="heading-md" style="color: var(--status-watch); margin-bottom: 6px;">🟡 Low Cancellation Risk (1-35%)</p>
                            <ul style="margin: 0 0 0 16px; padding: 0; font-size: 12px; color: var(--text-muted);">
                                @foreach (var item in (List<string>)ViewBag.LowRiskList)
                                {
                                    <li style="margin-bottom: 3px;">@item</li>
                                }
                            </ul>
                        </div>
                    }

                    @if (ViewBag.MedRiskList != null && ((List<string>)ViewBag.MedRiskList).Any())
                    {
                        <div class="alert-card-med">
                            <p class="heading-md" style="color: #f97316; margin-bottom: 6px;">🟠 Medium Cancellation Risk (36-70%)</p>
                            <ul style="margin: 0 0 0 16px; padding: 0; font-size: 12px; color: var(--text-muted);">
                                @foreach (var item in (List<string>)ViewBag.MedRiskList)
                                {
                                    <li style="margin-bottom: 3px;">@item</li>
                                }
                            </ul>
                        </div>
                    }

                    @if (ViewBag.HighRiskList != null && ((List<string>)ViewBag.HighRiskList).Any())
                    {
                        <div class="alert-card-high">
                            <p class="heading-md" style="color: var(--status-nogo); margin-bottom: 6px;">🔴 High Cancellation Risk (71-100%)</p>
                            <ul style="margin: 0 0 0 16px; padding: 0; font-size: 12px; color: var(--text-muted);">
                                @foreach (var item in (List<string>)ViewBag.HighRiskList)
                                {
                                    <li style="margin-bottom: 3px;">@item</li>
                                }
                            </ul>
                        </div>
                    }

                    <div style="margin-top: 12px;">
                        <a href="/Tour/Management" class="btn btn-danger-soft" style="width: 100%; box-sizing: border-box;">Review All Tours</a>
                    </div>
                }
                else
                {
                    <div style="background-color: var(--bg-primary); padding: 16px; border-radius: 8px; border: 1px solid var(--border-color); text-align: center;">
                        <p class="body-text" style="color: var(--text-muted); font-size: 13px;">No recorded cancellation risks found in active routes.</p>
                    </div>
                }
            </div>
        </aside>
    </div>

    <script>
        fetch('/Tour/CalculateNetPayables')
            .then(response => response.json())
            .then(data => {
                document.getElementById('operational-cost-display').innerText = '₱ ' + data.totalOperationalCosts.toLocaleString('en-PH', {minimumFractionDigits: 2});
            })
            .catch(err => {
                document.getElementById('operational-cost-display').innerText = 'Error';
            });

        // Dynamic Loading para sa bawat active tour instance
        @if (activeTours != null)
        {
            @foreach (var t in activeTours)
            {
                <text>
                fetch('/Analytics/BookingVelocity/@t.Id')
                    .then(res => res.json())
                    .then(data => {
                        let velocity = data.averageSlotsPerDay || 0;
                        let capacity = @t.TotalCapacity > 0 ? @t.TotalCapacity : 1;
                        let displayVal = velocity > 0 ? velocity + ' slots/day' : '0 slots/day';
                        
                        document.getElementById('velocity-@t.Id').innerText = velocity > 0 ? displayVal : 'N/A';

                        // Fill rate calculation based on booking velocity vs total capacity
                        let fillRate = (velocity / capacity) * 100;
                        let barWidth = Math.min(Math.max(fillRate, 0), 100); // Limit between 0% and 100%

                        // I-update ang bawat specific tour bar at label
                        let barElem = document.getElementById('graph-bar-@t.Id');
                        let labelElem = document.getElementById('graph-label-@t.Id');

                        if (barElem && labelElem) {
                            barElem.style.width = barWidth + '%';
                            labelElem.innerText = `${velocity} slots/day (${fillRate.toFixed(1)}% fill rate)`;

                            // Lagyan ng color coding base sa bilis ng fill rate performance
                            if (fillRate >= 30) {
                                barElem.className = 'graph-bar bar-high';
                                labelElem.style.color = 'var(--status-go)';
                            } else if (fillRate >= 10) {
                                barElem.className = 'graph-bar bar-med';
                                labelElem.style.color = '#f97316';
                            } else {
                                barElem.className = 'graph-bar bar-low';
                                labelElem.style.color = 'var(--status-watch)';
                            }
                        }
                    })
                    .catch(e => {
                        document.getElementById('velocity-@t.Id').innerText = 'N/A';
                        let labelElem = document.getElementById('graph-label-@t.Id');
                        if (labelElem) {
                            labelElem.innerText = 'Error loading velocity';
                            labelElem.style.color = 'var(--status-nogo)';
                        }
                    });
                </text>
            }
        }
    </script>
</body>
</html>
