@model IEnumerable<_UPDATED__FrontEnd_Capstone.Models.Tour>
@using System.Text.Encodings.Web
@{ 
    Layout = null; 
    var vendorPayablesMap = ViewBag.VendorPayablesMap as Dictionary<int, decimal> ?? new Dictionary<int, decimal>();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>J-Hub | Tour Management</title>
    <style>
        :root { --bg-primary: #0f172a; --bg-secondary: #1e293b; --border-color: #334155; --text-primary: #ffffff; --text-muted: #94a3b8; --accent-blue: #3b82f6; --status-go: #22c55e; --status-watch: #eab308; --status-nogo: #ef4444; --accent-boost: #f59e0b; }
        body { margin: 0; padding: 0; box-sizing: border-box; background-color: var(--bg-primary); font-family: system-ui, sans-serif; color: var(--text-primary); }
        .dashboard-layout { display: grid; grid-template-columns: 250px 1fr; height: 100vh; overflow: hidden; }
        .sidebar { background-color: var(--bg-secondary); padding: 24px; border-right: 1px solid var(--border-color); display: flex; flex-direction: column; }
        .main-content { padding: 32px; overflow-y: auto; }
        .data-table { width: 100%; border-collapse: collapse; background-color: var(--bg-secondary); border-radius: 8px; overflow: hidden; }
        .data-table th, .data-table td { text-align: left; padding: 16px; border-bottom: 1px solid var(--border-color); }
        .data-table th { background-color: rgba(0,0,0,0.2); font-size: 12px; letter-spacing: 0.05em; color: var(--text-muted); }
        .heading-xl { font-size: 28px; font-weight: 700; margin: 0; }
        .heading-md { font-size: 15px; font-weight: 600; margin: 0; }
        .heading-lg { font-size: 24px; font-weight: 700; margin: 0; }
        .body-text { font-size: 14px; line-height: 1.5; margin: 0; }
        .label-text { font-size: 12px; font-weight: 600; color: var(--text-muted); letter-spacing: 0.5px; }
        .btn { padding: 10px 20px; border-radius: 8px; font-size: 14px; font-weight: 600; cursor: pointer; border: none; }
        .btn-primary { background-color: #2563eb; color: white; }
        .btn-secondary { background-color: #475569; color: white; }
        .btn-info { background-color: #0284c7; color: white; }
        .btn-warning { background-color: #d97706; color: white; }
        .btn-danger { background-color: #ef4444; color: white; }
        .btn-boost { background-color: #334155; color: #f59e0b; border: 1px solid #f59e0b; }
        .btn-boosted { background-color: #f59e0b; color: #0f172a; }
        .badge { padding: 4px 8px; border-radius: 4px; font-size: 12px; font-weight: 600; display: inline-block; }
        .bg-active { background-color: rgba(34, 197, 94, 0.2); color: var(--status-go); }
        .badge-boosted { background-color: rgba(245, 158, 11, 0.2); color: var(--accent-boost); margin-left: 6px; }
        .modal-overlay { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(15, 23, 42, 0.85); z-index: 1000; justify-content: center; align-items: center; }
        .modal-card { background-color: var(--bg-secondary); padding: 32px; border-radius: 12px; border: 1px solid var(--border-color); width: 100%; max-width: 550px; }
        .input-field { background-color: var(--bg-primary); border: 1px solid var(--border-color); color: var(--text-primary); padding: 10px 14px; border-radius: 6px; font-size: 14px; width: 100%; box-sizing: border-box; }
        .details-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 20px; }
        .details-group { background-color: var(--bg-primary); padding: 12px; border-radius: 6px; border: 1px solid var(--border-color); }
        .details-val { font-size: 14px; font-weight: 500; margin-top: 4px; color: var(--text-primary); }
        .vendor-badge { font-size: 10px; background-color: #2563eb; color: white; padding: 2px 6px; border-radius: 4px; margin-left: 8px; font-weight: bold; text-transform: uppercase; display: inline-block; }
        .vendor-subcard { border-left: 3px solid #3b82f6; padding-left: 10px; margin-top: 10px; }
        .booking-subcard { border-left: 3px solid #22c55e; padding-left: 10px; margin-top: 10px; background-color: rgba(0,0,0,0.1); padding: 10px; border-radius: 4px; }
    </style>
</head>
<body>
    <div class="dashboard-layout">
        <aside class="sidebar">
            <div style="margin-bottom: 32px; font-size: 20px; font-weight: 800;">J-Hub <span style="font-size: 14px; font-weight: 500; color: var(--text-muted);"> Admin</span></div>
            <nav style="display: flex; flex-direction: column; gap: 16px; height: 100%;">
                <a href="/Home/OperatorDashboard" class="body-text" style="color: var(--text-muted); text-decoration: none;">Dashboard</a>
                <a href="/Tour/Management" class="body-text" style="color: var(--text-primary); font-weight: 600; text-decoration: none;">Tour Management</a>
                <a href="/User/BookingQueue" class="body-text" style="color: var(--text-muted); text-decoration: none;">Booking Queue</a>
                <a href="/Tour/VendorManagement" class="body-text" style="color: var(--text-muted); text-decoration: none;">Vendors</a>
                <a href="/Home/Logout" onclick="sessionStorage.clear(); localStorage.clear();" class="body-text" style="color: var(--status-nogo); text-decoration: none; margin-top: auto;">Log Out</a>
            </nav>
        </aside>

        <main class="main-content">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
                <h1 class="heading-xl">Tour Management</h1>
                <div style="display: flex; gap: 10px;">
                    <a href="/Tour/ArchivedTours" class="btn btn-secondary" style="text-decoration: none;">📁 Archived Tours</a>
                    <a href="/Tour/Create" class="btn btn-primary" style="text-decoration: none;">+ Create New Tour</a>
                </div>
            </div>

            <table class="data-table">
                <thead>
                    <tr>
                        <th class="label-text">TOUR NAME</th>
                        <th class="label-text">DESTINATION</th>
                        <th class="label-text">DATES</th>
                        <th class="label-text">PRICE</th>
                        <th class="label-text">STATUS</th>
                        <th class="label-text">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null) {
                        foreach (var t in Model) {
                            decimal operationalCost = vendorPayablesMap.ContainsKey(t.Id) ? vendorPayablesMap[t.Id] : t.OperationalCost;

                            var explicitVendorList = new List<object>();
                            if (t.Vendor != null) {
                                explicitVendorList.Add(new { name = t.Vendor.VendorName ?? "Unnamed", service = t.Vendor.ServiceType ?? "N/A", contact = t.Vendor.ContactInfo ?? "N/A", terms = t.Vendor.PaymentTerms ?? "N/A" });
                            }
                            string serializedVendors = System.Text.Json.JsonSerializer.Serialize(explicitVendorList);
                            string base64Vendors = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(serializedVendors));

                            var explicitBookingList = new List<object>();
                            if (t.Bookings != null) {
                                foreach (var b in t.Bookings) {
                                    explicitBookingList.Add(new {
                                        leadName = b.LeadName ?? "Unknown Lead",
                                        leadEmail = b.LeadEmail ?? "N/A",
                                        companionNames = b.CompanionNames ?? "None",
                                        slots = b.Slots,
                                        totalAmount = b.TotalAmount.ToString("N2", System.Globalization.CultureInfo.InvariantCulture),
                                        status = b.Status
                                    });
                                }
                            }
                            string serializedBookings = System.Text.Json.JsonSerializer.Serialize(explicitBookingList);
                            string base64Bookings = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(serializedBookings));

                            <tr>
                                <td class="heading-md">
                                    @t.TourName
                                    @if (t.IsBoosted) {
                                        <span class="badge badge-boosted">⭐ BOOSTED</span>
                                    }
                                </td>
                                <td class="body-text">@t.Destination</td>
                                <td class="body-text">@t.DepartureDate.ToString("MMM dd") - @t.ReturnDate.ToString("MMM dd")</td>
                                <td class="body-text">₱@t.BasePrice.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)</td>
                                <td><span class="badge bg-active">@t.Status</span></td>
                                <td>
                                    <div style="display: flex; gap: 8px; align-items: center;">
                                        <button class="btn btn-info" style="padding: 6px 12px; font-size: 12px;" onclick="openDetailsModal(
                                            '@JavaScriptEncoder.Default.Encode(t.TourName)', 
                                            '@JavaScriptEncoder.Default.Encode(t.Destination)', 
                                            '@t.DepartureDate.ToString("MMMM dd, yyyy hh:mm tt")', 
                                            '@t.ReturnDate.ToString("MMMM dd, yyyy hh:mm tt")', 
                                            '₱@t.BasePrice.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)', 
                                            '₱@operationalCost.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)', 
                                            '@t.SlotsFilled / @t.TotalCapacity', 
                                            '@t.Deadline.ToString("MMMM dd, yyyy")', 
                                            '@JavaScriptEncoder.Default.Encode(t.Status)', 
                                            '@JavaScriptEncoder.Default.Encode(t.ItineraryHighlights ?? "No highlights specified.")', 
                                            '@base64Vendors',
                                            '@base64Bookings'
                                        )">View</button>
                                        
                                        <button class="btn btn-secondary" style="padding: 6px 12px; font-size: 12px;" onclick="openEditModal('@t.Id', '@JavaScriptEncoder.Default.Encode(t.TourName)', '@JavaScriptEncoder.Default.Encode(t.Destination)', '@t.DepartureDate.ToString("yyyy-MM-ddTHH:mm")', '@t.ReturnDate.ToString("yyyy-MM-ddTHH:mm")', '@t.BasePrice', '@t.TotalCapacity', '@t.Status', '@JavaScriptEncoder.Default.Encode(t.ItineraryHighlights ?? "")')">Edit</button>
                                        
                                        <!-- Boost Button -->
                                        <form method="POST" action="/Tour/ToggleBoost" style="margin: 0;">
                                            <input type="hidden" name="id" value="@t.Id" />
                                            @if (t.IsBoosted) {
                                                <button type="submit" class="btn btn-boosted" style="padding: 6px 12px; font-size: 12px;" title="Unboost this tour">⭐ Unboost</button>
                                            } else {
                                                <button type="submit" class="btn btn-boost" style="padding: 6px 12px; font-size: 12px;" title="Boost this tour">☆ Boost</button>
                                            }
                                        </form>

                                        <!-- Cancel Button -->
                                        <form method="POST" action="/Tour/CancelTour" style="margin: 0;" onsubmit="return confirm('Are you sure you want to cancel this tour?');">
                                            <input type="hidden" name="id" value="@t.Id" />
                                            <button type="submit" class="btn btn-danger" style="padding: 6px 12px; font-size: 12px;">Cancel Tour</button>
                                        </form>

                                        <!-- Mark as Complete Button -->
                                        <form method="POST" action="/Tour/MarkAsComplete" style="margin: 0;" onsubmit="return confirm('Are you sure you want to mark this tour as complete?');">
                                            <input type="hidden" name="id" value="@t.Id" />
                                            <button type="submit" class="btn btn-warning" style="padding: 6px 12px; font-size: 12px;">Mark as Complete</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </main>
    </div>

    <div id="view-tour-modal" class="modal-overlay">
        <div class="modal-card" style="max-width: 650px; max-height: 85vh; overflow-y: auto;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 1px solid var(--border-color); padding-bottom: 12px;">
                <h2 class="heading-lg" id="view-title">Tour Details</h2>
                <span class="badge bg-active" id="view-status">Status</span>
            </div>
            <div class="details-grid">
                <div class="details-group"><div class="label-text">DESTINATION</div><div id="view-dest" class="details-val"></div></div>
                <div class="details-grid" style="grid-template-columns: 1fr 1fr; gap: 8px; margin: 0;">
                    <div class="details-group"><div class="label-text">BASE PRICE</div><div id="view-price" class="details-val" style="color: var(--status-go); font-weight: 700;"></div></div>
                    <div class="details-group"><div class="label-text">OPERATIONAL COST</div><div id="view-cost" class="details-val" style="color: var(--status-nogo);"></div></div>
                </div>
                <div class="details-group"><div class="label-text">DEPARTURE TIMELINE</div><div id="view-dep" class="details-val"></div></div>
                <div class="details-group"><div class="label-text">RETURN TIMELINE</div><div id="view-ret" class="details-val"></div></div>
                <div class="details-group" style="grid-column: 1 / -1;"><div class="label-text">SLOTS (FILLED/CAPACITY)</div><div id="view-slots" class="details-val"></div></div>
                <div class="details-group" style="grid-column: 1 / -1;"><div class="label-text">REGISTRATION DEADLINE</div><div id="view-deadline" class="details-val"></div></div>
            </div>
            
            <div class="details-group" style="margin-bottom: 16px;">
                <div class="label-text">ASSOCIATED OPERATION VENDOR</div>
                <div id="view-vendors-container" style="margin-top: 4px;"></div>
            </div>

            <div class="details-group" style="margin-bottom: 16px;">
                <div class="label-text">BOOKINGS & PARTICIPANTS</div>
                <div id="view-bookings-container" style="margin-top: 4px;"></div>
            </div>

            <div class="details-group" style="margin-bottom: 24px;"><div class="label-text">ITINERARY HIGHLIGHTS</div><div id="view-itin-highlights" class="details-val" style="white-space: pre-wrap; line-height: 1.4;"></div></div>
            
            <button type="button" onclick="document.getElementById('view-tour-modal').style.display='none'" class="btn btn-secondary" style="width: 100%;">Close Panel</button>
        </div>
    </div>

    <div id="edit-tour-modal" class="modal-overlay">
        <div class="modal-card" style="max-width: 600px;">
            <h2 class="heading-lg" style="margin-bottom: 20px; color: var(--text-primary);">Edit Tour</h2>
            
            <form action="/Tour/UpdateFull" method="POST" onsubmit="cleanPriceBeforeSubmit()">
                <input type="hidden" id="modal-tour-id" name="id" />
                
                <div style="margin-bottom: 15px;">
                    <label class="label-text">TOUR NAME</label>
                    <input type="text" id="edit-tour-name" name="tourName" class="input-field" required />
                </div>

                <div style="margin-bottom: 15px;">
                    <label class="label-text">DESTINATION</label>
                    <input type="text" id="edit-tour-dest" name="destination" class="input-field" required />
                </div>
                
                <div class="details-grid" style="grid-template-columns: 1fr 1fr;">
                    <div>
                        <label class="label-text">DEPARTURE</label>
                        <input type="datetime-local" id="edit-tour-dep" name="departureDate" class="input-field" />
                    </div>
                    <div>
                        <label class="label-text">RETURN</label>
                        <input type="datetime-local" id="edit-tour-ret" name="returnDate" class="input-field" />
                    </div>
                </div>

                <div class="details-grid" style="grid-template-columns: 1fr 1fr;">
                    <div>
                        <label class="label-text">BASE PRICE</label>
                        <input type="text" id="edit-tour-price" name="basePrice" class="input-field" oninput="formatPriceInput(this)" />
                    </div>
                    <div>
                        <label class="label-text">TOTAL CAPACITY</label>
                        <input type="number" id="edit-tour-cap" name="totalCapacity" class="input-field" />
                    </div>
                </div>

                <div style="margin-bottom: 15px;">
                    <label class="label-text">STATUS</label>
                    <select id="edit-tour-status" name="status" class="input-field">
                        <option value="Active">Active</option>
                        <option value="Draft">Draft</option>
                        <option value="Cancelled">Cancelled</option>
                    </select>
                </div>

                <div style="margin-bottom: 20px;">
                    <label class="label-text">ITINERARY HIGHLIGHTS</label>
                    <textarea id="edit-tour-itin" name="itineraryHighlights" class="input-field" rows="3"></textarea>
                </div>

                <div style="display: flex; gap: 10px;">
                    <button type="submit" class="btn btn-primary" style="flex: 1;">Save Changes</button>
                    <button type="button" class="btn btn-secondary" onclick="document.getElementById('edit-tour-modal').style.display='none'" style="flex: 1;">Cancel</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function openDetailsModal(name, dest, dep, ret, price, cost, slots, deadline, status, itin, vendorBase64, bookingBase64) {
            document.getElementById('view-title').innerText = decodeURIComponent(name);
            document.getElementById('view-dest').innerText = decodeURIComponent(dest);
            document.getElementById('view-dep').innerText = dep;
            document.getElementById('view-ret').innerText = ret;
            document.getElementById('view-price').innerText = price;
            document.getElementById('view-cost').innerText = cost;
            document.getElementById('view-slots').innerText = slots;
            document.getElementById('view-deadline').innerText = deadline;
            document.getElementById('view-status').innerText = decodeURIComponent(status);
            document.getElementById('view-itin-highlights').innerText = decodeURIComponent(itin);
            
            const container = document.getElementById('view-vendors-container');
            container.innerHTML = '';
            try {
                const jsonString = decodeURIComponent(atob(vendorBase64).split('').map(function(c) {
                    return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
                }).join(''));
                const vendors = JSON.parse(jsonString);

                if (!vendors || vendors.length === 0) {
                    container.innerHTML = '<div class="body-text" style="color: var(--text-muted); font-style: italic;">No vendor assigned.</div>';
                } else {
                    vendors.forEach(v => {
                        const card = document.createElement('div');
                        card.className = 'vendor-subcard';
                        card.innerHTML = `
                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 4px;">
                                <div><div class="label-text" style="font-size: 10px;">VENDOR NAME</div><div class="heading-md" style="color: var(--text-primary); margin-top: 2px;">${v.name}</div></div>
                                <div><div class="label-text" style="font-size: 10px;">SERVICE TYPE</div><div class="body-text" style="margin-top: 2px;"><span class="vendor-badge" style="margin-left: 0;">${v.service}</span></div></div>
                            </div>
                            <div class="body-text" style="color: var(--text-muted); font-size: 13px; border-top: 1px solid var(--border-color); margin-top: 6px; padding-top: 4px;">
                                <strong>Contact:</strong> ${v.contact} | <strong>Terms:</strong> ${v.terms}
                            </div>
                        `;
                        container.appendChild(card);
                    });
                }
            } catch (err) {
                container.innerHTML = '<div class="body-text" style="color: var(--status-nogo);">Failed to parse vendor data.</div>';
            }

            const bookingContainer = document.getElementById('view-bookings-container');
            bookingContainer.innerHTML = '';
            try {
                const bJsonString = decodeURIComponent(atob(bookingBase64).split('').map(function(c) {
                    return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
                }).join(''));
                const bookings = JSON.parse(bJsonString);

                if (!bookings || bookings.length === 0) {
                    bookingContainer.innerHTML = '<div class="body-text" style="color: var(--text-muted); font-style: italic;">No bookings found for this tour.</div>';
                } else {
                    bookings.forEach(b => {
                        const bCard = document.createElement('div');
                        bCard.className = 'booking-subcard';
                        bCard.innerHTML = `
                            <div style="display: flex; justify-content: space-between; align-items: center;">
                                <div class="heading-md" style="color: var(--text-primary);">Lead: ${b.leadName}</div>
                                <span class="badge bg-active">${b.status}</span>
                            </div>
                            <div class="body-text" style="font-size: 13px; color: var(--text-muted); margin-top: 4px;">
                                <strong>Email:</strong> ${b.leadEmail} | <strong>Slots:</strong> ${b.slots} | <strong>Total:</strong> ₱${b.totalAmount}
                            </div>
                            <div class="body-text" style="font-size: 13px; color: var(--text-primary); margin-top: 6px; border-top: 1px dashed var(--border-color); padding-top: 4px;">
                                <strong>Companion Name(s):</strong> ${b.companionNames ? b.companionNames : 'None'}
                            </div>
                        `;
                        bookingContainer.appendChild(bCard);
                    });
                }
            } catch (err) {
                bookingContainer.innerHTML = '<div class="body-text" style="color: var(--status-nogo);">Failed to parse booking data.</div>';
            }

            document.getElementById('view-tour-modal').style.display = 'flex';
        }

        function formatPriceInput(input) { 
            let value = input.value.replace(/[^\d.]/g, ''); 
            let parts = value.split('.'); 
            if (parts.length > 2) { parts = [parts[0], parts.slice(1).join('')]; } 
            parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ','); 
            input.value = parts.join('.'); 
        }
        function cleanPriceBeforeSubmit() { 
            let priceField = document.getElementById('edit-tour-price'); 
            priceField.value = priceField.value.replace(/,/g, ''); 
        }
        function openEditModal(id, name, dest, dep, ret, price, cap, status, itin) {
            document.getElementById('modal-tour-id').value = id;
            document.getElementById('edit-tour-name').value = decodeURIComponent(name);
            document.getElementById('edit-tour-dest').value = decodeURIComponent(dest);
            document.getElementById('edit-tour-dep').value = dep;
            document.getElementById('edit-tour-ret').value = ret;
            let rawPrice = price.replace(/₱/g, '').replace(/,/g, ''); 
            let priceInput = document.getElementById('edit-tour-price');
            priceInput.value = rawPrice; 
            formatPriceInput(priceInput);
            document.getElementById('edit-tour-cap').value = cap;
            document.getElementById('edit-tour-status').value = status;
            document.getElementById('edit-tour-itin').value = decodeURIComponent(itin);
            document.getElementById('edit-tour-modal').style.display = 'flex';
        }
    </script>
</body>
</html>
