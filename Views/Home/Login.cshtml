@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>J-Hub | Secure Login</title>
    
    <style>
        /* Hardcoded modern dark palette - zero external files required */
        body {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            background-color: #0f172a; /* Slate 900 */
            font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100vh;
        }

        .auth-container {
            width: 100%;
            max-width: 420px;
            padding: 20px;
        }

        .auth-card {
            background-color: #1e293b; /* Slate 800 */
            padding: 40px;
            border-radius: 16px;
            border: 1px solid #334155; /* Slate 700 */
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3), 0 10px 10px -5px rgba(0, 0, 0, 0.2);
        }

        .brand-title {
            text-align: center; 
            margin: 0 0 8px 0; 
            font-size: 32px; 
            font-weight: 800; 
            color: #ffffff;
            letter-spacing: -0.5px;
        }

        .brand-subtitle {
            text-align: center; 
            color: #94a3b8; /* Slate 400 */
            margin: 0 0 32px 0; 
            font-size: 14px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .label-layout {
            display: flex; 
            justify-content: space-between;
            margin-bottom: 8px;
        }

        .label-text {
            font-size: 14px;
            font-weight: 500;
            color: #cbd5e1; /* Slate 300 */
        }

        .forgot-link {
            color: #3b82f6; /* Blue 500 */
            text-decoration: none; 
            font-size: 14px;
            font-weight: 500;
        }

        .forgot-link:hover {
            text-decoration: underline;
        }

        .input-field {
            width: 100%;
            padding: 12px 16px;
            background-color: #0f172a; /* Slate 900 */
            border: 1px solid #475569; /* Slate 600 */
            border-radius: 8px;
            color: #ffffff;
            font-size: 15px;
            transition: border-color 0.2s;
            box-sizing: border-box;
        }

        .input-field:focus {
            outline: none;
            border-color: #3b82f6;
        }

        .btn-primary {
            width: 100%;
            background-color: #2563eb; /* Blue 600 */
            color: #ffffff;
            border: none;
            padding: 14px;
            border-radius: 8px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: background-color 0.2s;
            margin-top: 10px;
            margin-bottom: 20px;
        }

        .btn-primary:hover {
            background-color: #1d4ed8; /* Blue 700 */
        }

        .register-text {
            text-align: center; 
            color: #94a3b8; 
            font-size: 14px;
            margin: 0;
        }

        .register-link {
            color: #3b82f6; 
            text-decoration: none; 
            font-weight: 600;
        }

        .register-link:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>
    <div class="auth-container">
        <div class="auth-card">
            <h1 class="brand-title">J-Hub</h1>
            <p class="brand-subtitle">Enter your credentials to continue</p>
            
            <form id="login-form" method="POST" action="/Home/Login">
                
                @if (ViewBag.ErrorMessage != null)
                {
                    <div style="background-color: rgba(239, 68, 68, 0.15); color: #f87171; padding: 12px; border-radius: 8px; margin-bottom: 20px; font-size: 14px; text-align: center; border: 1px solid rgba(239, 68, 68, 0.4);">
                        @ViewBag.ErrorMessage
                    </div>
                }

                <div class="form-group">
                    <div class="label-layout">
                        <label class="label-text">Email Address</label>
                    </div>
                    <input type="email" id="email" name="email" class="input-field" placeholder="name@example.com" required>
                </div>
                
                <div class="form-group">
                    <div class="label-layout">
                        <label class="label-text">Password</label>
                        <a href="/forgot-password.html" class="forgot-link">Forgot Password?</a>
                    </div>
                    <input type="password" id="password" name="password" class="input-field" placeholder="••••••••" required>
                </div>
                
                <button type="submit" class="btn-primary">Log In</button>
            </form>
            
           <p class="register-text">
                     Don't have an account? <a asp-controller="Home" asp-action="Register" class="register-link">Create One</a>
            </p>
        </div>
    </div>
</body>
</html>
