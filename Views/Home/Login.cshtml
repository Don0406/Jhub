@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>J-Hub | Login</title>
    <style>
        :root {
            --bg-primary: #0f172a;   /* Slate 900 */
            --bg-secondary: #1e293b;  /* Slate 800 */
            --border-color: #334155;  /* Slate 700 */
            --text-muted: #94a3b8;    /* Slate 400 */
            --accent-blue: #3b82f6;   /* Blue 500 */
        }

        body {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            background-color: var(--bg-primary);
            font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            color: #ffffff;
        }

        .auth-container {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            background-color: var(--bg-primary);
            padding: 20px;
        }

        .auth-card {
            background-color: var(--bg-secondary);
            padding: 40px;
            border-radius: 12px;
            width: 100%;
            max-width: 420px;
            border: 1px solid var(--border-color);
            box-shadow: 0 10px 25px rgba(0,0,0,0.5);
        }

        .heading-lg {
            color: #ffffff;
            font-size: 32px;
            font-weight: 800;
            letter-spacing: -0.5px;
        }

        .body-text {
            font-size: 14px;
            color: #ffffff;
        }

        .label-text {
            font-size: 14px;
            font-weight: 500;
            color: #cbd5e1;
        }

        .input-field {
            width: 100%;
            padding: 12px 16px;
            background-color: #0f172a !important;
            border: 1px solid #475569 !important;
            border-radius: 8px;
            color: #ffffff !important;
            font-size: 15px;
            box-sizing: border-box;
            margin-top: 8px;
        }

        .input-field:focus {
            outline: none;
            border-color: var(--accent-blue) !important;
        }

        .btn-primary {
            width: 100%;
            background-color: #2563eb !important;
            color: #ffffff !important;
            border: none;
            padding: 14px;
            border-radius: 8px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: background-color 0.2s;
        }

        .btn-primary:hover {
            background-color: #1d4ed8 !important;
        }
    </style>
</head>
<body>
    <div class="auth-container">
        <div class="auth-card">
            <h1 class="heading-lg" style="text-align: center; margin-bottom: 8px;">Welcome Back</h1>
            <p class="body-text" style="text-align: center; color: var(--text-muted); margin-bottom: 32px;">Please sign in to your account to continue.</p>
            
            <!-- Error message para sa invalid credentials o pending/rejected status -->
            @if (ViewBag.ErrorMessage != null)
            {
                <div style="background-color: rgba(239, 68, 68, 0.15); color: #f87171; padding: 12px; border-radius: 8px; margin-bottom: 20px; font-size: 14px; text-align: center; border: 1px solid rgba(239, 68, 68, 0.4);">
                    @ViewBag.ErrorMessage
                </div>
            }

            <!-- Mensahe pagkatapos mag-register galing sa TempData -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div style="background-color: rgba(59, 130, 246, 0.15); color: #60a5fa; padding: 12px; border-radius: 8px; margin-bottom: 20px; font-size: 14px; text-align: center; border: 1px solid rgba(59, 130, 246, 0.4);">
                    @TempData["SuccessMessage"]
                </div>
            }

            <form method="POST" action="/Home/Login">
                <div style="margin-bottom: 16px;">
                    <label class="label-text">Email Address</label>
                    <input type="email" name="email" class="input-field" placeholder="name@example.com" required>
                </div>

                <div style="margin-bottom: 24px;">
                    <label class="label-text">Password</label>
                    <input type="password" name="password" class="input-field" placeholder="••••••••" required>
                </div>
                
                <button type="submit" class="btn-primary" style="margin-bottom: 16px;">Log In</button>
            </form>
            
            <p class="body-text" style="text-align: center; color: var(--text-muted);">
                Don't have an account? <a asp-controller="Home" asp-action="Register" style="color: var(--accent-blue); text-decoration: none; font-weight: 500;">Register</a>
            </p>
        </div>
    </div>
</body>
</html>
