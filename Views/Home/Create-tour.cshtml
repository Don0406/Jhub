@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>J-Hub | Create New Tour</title>
    <style>
        :root { 
            --bg-primary: #0f172a; 
            --bg-secondary: #1e293b; 
            --border-color: #334155; 
            --text-primary: #ffffff; 
            --text-muted: #94a3b8; 
            --accent-blue: #3b82f6; 
            --status-go: #22c55e; 
            --status-watch: #eab308; 
            --status-nogo: #ef4444; 
        }
        
        body { 
            margin: 0; 
            padding: 0; 
            box-sizing: border-box; 
            background-color: var(--bg-primary); 
            font-family: system-ui, sans-serif; 
            color: var(--text-primary); 
        }

        .dashboard-layout { 
            display: grid; 
            grid-template-columns: 250px 1fr; 
            min-height: 100vh; 
            overflow: hidden; 
        }

        .sidebar { 
            background-color: var(--bg-secondary); 
            padding: 24px; 
            border-right: 1px solid var(--border-color); 
            display: flex; 
            flex-direction: column; 
        }

        .main-content { 
            padding: 32px; 
            height: 100vh;
            overflow-y: auto; 
        }

        .form-panel { 
            background-color: var(--bg-secondary); 
            padding: 24px; 
            border-radius: 8px; 
            border: 1px solid var(--border-color); 
            margin-bottom: 24px; 
        }

        .form-grid { 
            display: grid; 
            grid-template-columns: 1fr 1fr; 
            gap: 16px; 
            margin-top: 16px; 
        }

        .full-width { 
            grid-column: span 2; 
        }

        .heading-xl { 
            font-size: 28px; 
            font-weight: 700; 
            margin: 0; 
        }

        .body-text { 
            font-size: 14px; 
            line-height: 1.5; 
            margin: 0; 
        }

        .label-text { 
            font-size: 12px; 
            font-weight: 600; 
            color: var(--text-muted); 
            letter-spacing: 0.5px; 
        }

        .input-field { 
            background-color: var(--bg-primary); 
            border: 1px solid var(--border-color); 
            color: var(--text-primary); 
            padding: 10px 14px; 
            border-radius: 6px; 
            font-size: 14px; 
            width: 100%; 
            box-sizing: border-box; 
        }

        .input-field:disabled { 
            opacity: 0.5; 
            cursor: not-allowed; 
        }

        .btn { 
            padding: 10px 20px; 
            border-radius: 8px; 
            font-size: 14px; 
            font-weight: 600; 
            cursor: pointer; 
            border: none; 
        }

        .btn-primary { 
            background-color: #2563eb; 
            color: white; 
        }

        .btn-secondary { 
            background-color: #475569; 
            color: white; 
        }
        
        #lower-tour-form-container {
            display: none !important;
        }

        .spinner {
            display: inline-block;
            width: 16px;
            height: 16px;
            border: 2px solid rgba(255,255,255,0.3);
            border-radius: 50%;
            border-top-color: white;
            animation: spin 0.8s linear infinite;
            margin-right: 8px;
            vertical-align: middle;
        }

        @@keyframes spin { 
            to { transform: rotate(360deg); } 
        }

        @@media (max-width: 768px) {
            .dashboard-layout {
                grid-template-columns: 1fr;
                height: auto;
                overflow: auto;
            }
            .sidebar {
                border-right: none;
                border-bottom: 1px solid var(--border-color);
            }
            .form-grid {
                grid-template-columns: 1fr;
            }
            .full-width {
                grid-column: span 1;
            }
        }
    </style>
</head>
<body>
    <div class="dashboard-layout">
        <aside class="sidebar">
            <div style="margin-bottom: 32px; font-size: 20px; font-weight: 800;">J-Hub <span style="font-size: 14px; font-weight: 500; color: var(--text-muted);">Operator</span></div>
            <nav style="display: flex; flex-direction: column; gap: 16px; height: 100%;">
                <a href="/Home/OperatorDashboard" class="body-text" style="color: var(--text-muted); text-decoration: none;">Dashboard</a>
                <a href="/Tour/Management" class="body-text" style="color: var(--text-primary); font-weight: 600; text-decoration: none;">Tour Management</a>
                <a href="/User/BookingQueue" class="body-text" style="color: var(--text-muted); text-decoration: none;">Booking Queue</a>
                <a href="/Tour/VendorManagement" class="body-text" style="color: var(--text-muted); text-decoration: none;">Vendors</a>
                <a href="/User/UserManagement" class="body-text" style="color: var(--text-muted); text-decoration: none;">User Management (RBAC)</a>
                <a href="/Home/Logout" onclick="sessionStorage.clear(); localStorage.clear();" class="body-text" style="color: var(--status-nogo); text-decoration: none; margin-top: auto;">Log Out</a>
            </nav>
        </aside>

        <main class="main-content">
            <h1 class="heading-xl" style="margin-bottom: 24px;">Create New Tour</h1>
            
            <form method="POST" action="/Tour/Create" enctype="multipart/form-data" onsubmit="cleanCapacityBeforeSubmit()">
                
                <div class="form-panel" style="border: 1px solid var(--accent-blue); background-color: rgba(59, 130, 246, 0.02);">
                    <h3 style="margin-top: 0; margin-bottom: 4px; color: var(--accent-blue); font-size: 16px;">1. AI Prescriptive Generation Engine</h3>
                    <p class="body-text" style="color: var(--text-muted); margin-bottom: 16px; border-bottom: 1px solid var(--border-color); padding-bottom: 8px;">
                        Mag-type ng itinerary o destinasyon sa baba. Kapag nagka-error ang AI, awtomatiko itong gagamit ng fallback data para hindi maabala ang paggawa mo.
                    </p>
                    <div class="form-grid" style="margin-top: 0;">
                        <div>
                            <label class="label-text">Target Destination Route</label>
                            <input list="destination-options" id="constraint-destination" class="input-field" placeholder="e.g. Batanes, Sagada, Palawan" style="margin-top: 6px;">
                            <datalist id="destination-options">
                                <option value="Sagada, Mountain Province"></option>
                                <option value="Siargao, Surigao del Norte"></option>
                                <option value="Basco, Batanes"></option>
                                <option value="El Nido, Palawan"></option>
                                <option value="Boracay, Aklan"></option>
                            </datalist>
                        </div>
                        <div>
                            <label class="label-text">Target Slot Capacity (Pax)</label>
                            <input type="number" id="constraint-capacity" class="input-field" value="14" min="2" max="30" style="margin-top: 6px;">
                        </div>
                        <div class="full-width">
                            <label class="label-text">Itinerary / Package Description Prompt</label>
                            <textarea id="constraint-itinerary-desc" class="input-field" rows="2" placeholder="Halimbawa: 3d2n beach tour with island hopping..." style="margin-top: 6px;" oninput="toggleLowerForm()"></textarea>
                        </div>
                        <div class="full-width" style="text-align: right;">
                            <button type="button" id="generate-engine-btn" class="btn btn-primary" style="padding: 10px 24px;" onclick="runGenerationAlgorithm()">
                                Run AI Auto-Generate Form
                            </button>
                        </div>
                    </div>
                </div>

                <div id="lower-tour-form-container">
                    <div class="form-panel">
                        <h3 style="margin-top: 0; margin-bottom: 16px; font-size: 16px; border-bottom: 1px solid var(--border-color); padding-bottom: 8px;">2. Tour Details (Auto-Generated & Editable)</h3>
                        <div class="form-grid">
                            <div>
                                <label class="label-text" style="margin-bottom: 6px; display: block;">TOUR NAME</label>
                                <input type="text" name="tourName" id="tourNameField" class="input-field" required>
                            </div>
                            <div>
                                <label class="label-text" style="margin-bottom: 6px; display: block;">DESTINATION</label>
                                <input type="text" name="destination" id="destinationField" class="input-field" required>
                            </div>
                            
                            <div>
                                <label class="label-text" style="margin-bottom: 6px; display: block;">LANDSCAPE TYPE</label>
                                <input list="landscape-options" name="LandscapeType" id="LandscapeTypeField" class="input-field" placeholder="Select or type landscape type..." required>
                                <datalist id="landscape-options">
                                    <option value="Mountain / Highlands"></option>
                                    <option value="Coastal / Beach"></option>
                                    <option value="Urban / City"></option>
                                    <option value="Forest / Jungle"></option>
                                    <option value="Island"></option>
                                    <option value="Countryside"></option>
                                </datalist>
                            </div>
                            <div>
                                <label class="label-text" style="margin-bottom: 6px; display: block;">INTENSITY LEVEL</label>
                                <input list="intensity-options" name="IntensityLevel" id="IntensityLevelField" class="input-field" placeholder="Select or type intensity level..." required>
                                <datalist id="intensity-options">
                                    <option value="Low"></option>
                                    <option value="Moderate"></option>
                                    <option value="High"></option>
                                    <option value="Extreme"></option>
                                </datalist>
                            </div>
                            <div class="full-width">
                                <label class="label-text" style="margin-bottom: 6px; display: block;">ACTIVITIES</label>
                                <input list="activity-options" name="Activities" id="ActivitiesField" class="input-field" placeholder="Select or type activities..." required>
                                <datalist id="activity-options">
                                    <option value="Hiking & Trekking"></option>
                                    <option value="Swimming & Island Hopping"></option>
                                    <option value="Sightseeing & Cultural Tour"></option>
                                    <option value="Food Trip & Leisure"></option>
                                    <option value="Snorkeling & Diving"></option>
                                </datalist>
                            </div>

                            <div class="full-width">
                                <label class="label-text" style="margin-bottom: 6px; display: block;">SHORT DESCRIPTION</label>
                                <textarea name="shortDescription" id="shortDescriptionField" class="input-field" rows="2" placeholder="Enter a brief summary overview of the tour package..."></textarea>
                            </div>

                            <div>
                                <label class="label-text" style="margin-bottom: 6px; display: block;">BASE PRICE (₱)</label>
                                <input type="text" id="basePriceVisual" class="input-field" placeholder="0.00" required>
                                <input type="hidden" name="basePrice" id="basePriceActual">
                            </div>
                            <div>
                                <label class="label-text" style="margin-bottom: 6px; display: block;">TOTAL CAPACITY</label>
                                <input type="text" name="totalCapacity" id="totalCapacityField" class="input-field" placeholder="0" oninput="formatCapacityInput(this)" required>
                            </div>

                            <div>
                                <label class="label-text" style="margin-bottom: 6px; display: block;">DEPARTURE DATE & TIME</label>
                                <input type="datetime-local" name="departureDate" id="departureDateField" class="input-field" required>
                            </div>
                            <div>
                                <label class="label-text" style="margin-bottom: 6px; display: block;">RETURN DATE & TIME</label>
                                <input type="datetime-local" name="returnDate" id="returnDateField" class="input-field" required>
                            </div>

                            <div class="full-width">
                                <label class="label-text" style="margin-bottom: 6px; display: block;">HIGHLIGHTS</label>
                                <input type="text" name="itineraryHighlights" id="itineraryHighlightsField" class="input-field">
                            </div>
                            <div class="full-width">
                                <label class="label-text" style="margin-bottom: 6px; display: block;">UPLOAD TOUR IMAGE</label>
                                <input type="file" name="imageFile" class="input-field" accept="image/*">
                            </div>

                            <div class="full-width" style="margin-top: 8px;">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                                    <label class="label-text" style="letter-spacing: 0.75px;">ASSIGNED VENDORS & LOGISTICS</label>
                                    <button type="button" class="btn btn-primary" style="padding: 6px 14px; font-size: 12px; background-color: var(--accent-blue);" onclick="addVendorRow()">+ Add Vendor Requirement</button>
                                </div>
                                <div id="vendor-rows-container" style="display: flex; flex-direction: column; gap: 12px;"></div>
                            </div>

                        </div>
                    </div>
                    
                    <div style="display: flex; gap: 12px; margin-bottom: 32px;">
                        <button type="submit" class="btn btn-primary">Save Tour</button>
                        <a href="/Tour/Management" class="btn btn-secondary" style="text-decoration: none; display: inline-flex; align-items: center;">Cancel</a>
                    </div>
                </div>
            </form>
        </main>
    </div>

    <template id="vendor-row-template">
        <div class="vendor-row" style="display: grid; grid-template-columns: 1fr 1fr auto; gap: 16px; align-items: center; background: rgba(255,255,255,0.02); padding: 16px; border-radius: 6px; border: 1px solid var(--border-color);">
            <div>
                <label class="label-text" style="font-size: 10px; margin-bottom: 4px; display: block;">VENDOR TYPE</label>
                <select name="vendorTypes" class="input-field vendor-type-select" required onchange="filterVendorNames(this)">
                    <option value="" disabled selected>Select Type First...</option>
                    <option value="Transport">Transport / Van Logistics</option>
                    <option value="Accommodation">Accommodation / Transient / Hotel</option>
                    <option value="Tour Guide">Local Coordinator / Guide</option>
                    <option value="Food & Catering">Food & Restaurant Services</option>
                    <option value="Activities">Activities / Environmental Fees</option>
                </select>
            </div>
            <div>
                <label class="label-text" style="font-size: 10px; margin-bottom: 4px; display: block;">ASSIGNED VENDOR NAME</label>
                <select name="vendorIds" class="input-field vendor-name-select" required disabled>
                    <option value="" disabled selected>Select Vendor Type muna...</option>
                </select>
            </div>
            <div style="padding-top: 16px;">
                <button type="button" class="btn" style="background-color: var(--status-nogo); color: white; padding: 10px 14px;" onclick="removeVendorRow(this)">✕</button>
            </div>
        </div>
    </template>

    <script>
        const allVendors = [
            @if (ViewBag.Vendors != null)
            {
                foreach (var v in ViewBag.Vendors)
                {
                    @: { id: @v.Id, name: "@Html.Raw(v.VendorName)", type: "@Html.Raw(v.ServiceType)" },
                }
            }
        ];

        function filterVendorNames(typeSelectElement) {
            const row = typeSelectElement.closest('.vendor-row');
            const nameSelect = row.querySelector('.vendor-name-select');
            const selectedType = typeSelectElement.value;

            nameSelect.disabled = false;
            nameSelect.innerHTML = '<option value="" disabled selected>Select Vendor Name...</option>';

            const filteredVendors = allVendors.filter(v => v.type === selectedType);

            if (filteredVendors.length === 0) {
                const option = document.createElement('option');
                option.value = "";
                option.textContent = "Walang vendor na nakarehistro sa uring ito";
                option.disabled = true;
                nameSelect.appendChild(option);
            } else {
                filteredVendors.forEach(vendor => {
                    const option = document.createElement('option');
                    option.value = vendor.id;
                    option.textContent = vendor.name;
                    nameSelect.appendChild(option);
                });
            }
        }

        function toggleLowerForm() {
            const descInput = document.getElementById('constraint-itinerary-desc').value;
            const lowerContainer = document.getElementById('lower-tour-form-container');
            
            if (descInput.trim().length > 0) {
                lowerContainer.style.setProperty('display', 'block', 'important');
            } else {
                lowerContainer.style.setProperty('display', 'none', 'important');
            }
        }

        async function runGenerationAlgorithm() {
            const destinationInput = document.getElementById('constraint-destination').value;
            const capacityInput = document.getElementById('constraint-capacity').value;
            const descInput = document.getElementById('constraint-itinerary-desc').value;
            const btn = document.getElementById('generate-engine-btn');
            const lowerContainer = document.getElementById('lower-tour-form-container');
            
            if (!destinationInput) {
                alert("Please select or type a target route destination.");
                return;
            }

            const userPrompt = `Destination: ${destinationInput}. Capacity: ${capacityInput} pax. Details/Itinerary: ${descInput}`;

            btn.disabled = true;
            btn.innerHTML = `<span class="spinner"></span>AI is generating tour package...`;
            lowerContainer.style.setProperty('display', 'block', 'important');

            let tourData = null;

            try {
                const response = await fetch('/Tour/GenerateTourWithAI', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ prompt: userPrompt })
                });

                if (!response.ok) {
                    throw new Error('API blocked or failed');
                }

                tourData = await response.json();

            } catch (error) {
                console.warn("Offline/Fallback Mode Activated: Ginagamit ang hardcoded data dahil hindi maka-connect sa AI.", error);
                
                tourData = {
                    TourName: `${destinationInput} Adventure Experience`,
                    Destination: destinationInput,
                    LandscapeType: "Mountain / Highlands",
                    IntensityLevel: "Moderate",
                    Activities: "Hiking & Trekking",
                    Description: descInput || `Exciting tour package going to ${destinationInput}. Enjoy scenic views and local attractions.`,
                    BasePrice: 4500.00,
                    TotalCapacity: parseInt(capacityInput) || 14,
                    DepartureDate: new Date(Date.now() + 86400000 * 7).toISOString().slice(0, 16),
                    ReturnDate: new Date(Date.now() + 86400000 * 10).toISOString().slice(0, 16),
                    ItineraryHighlights: "Scenic View, Local Food Trip, Guided Tour, Souvenir Shopping"
                };
            }

            document.getElementById('tourNameField').value = tourData.TourName || '';
            document.getElementById('destinationField').value = tourData.Destination || destinationInput;
            document.getElementById('LandscapeTypeField').value = tourData.LandscapeType || 'Mountain / Highlands';
            document.getElementById('IntensityLevelField').value = tourData.IntensityLevel || 'Moderate';
            document.getElementById('ActivitiesField').value = tourData.Activities || 'Hiking & Trekking';
            document.getElementById('shortDescriptionField').value = tourData.Description || descInput;
            document.getElementById('itineraryHighlightsField').value = tourData.ItineraryHighlights || '';
            
            const capField = document.getElementById('totalCapacityField');
            capField.value = tourData.TotalCapacity || capacityInput || "14";
            formatCapacityInput(capField);

            const visualInput = document.getElementById('basePriceVisual');
            const actualInput = document.getElementById('basePriceActual');
            const price = tourData.BasePrice || 4500.00;
            actualInput.value = price;
            visualInput.value = parseFloat(price).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

            if (tourData.DepartureDate) {
                document.getElementById('departureDateField').value = tourData.DepartureDate;
            }
            if (tourData.ReturnDate) {
                document.getElementById('returnDateField').value = tourData.ReturnDate;
            }

            btn.disabled = false;
            btn.innerText = "Run AI Auto-Generate Form";
        }

        function addVendorRow() {
            const template = document.getElementById('vendor-row-template');
            const clone = template.content.cloneNode(true);
            document.getElementById('vendor-rows-container').appendChild(clone);
        }

        function removeVendorRow(buttonElement) {
            const row = buttonElement.closest('.vendor-row');
            if (row) {
                row.remove();
            }
        }

        function formatCapacityInput(input) {
            let value = input.value.replace(/\D/g, '');
            if (value) {
                input.value = parseInt(value, 10).toLocaleString('en-US');
            } else {
                input.value = '';
            }
        }

        function cleanCapacityBeforeSubmit() {
            const capacityField = document.getElementById('totalCapacityField');
            if(capacityField) {
                capacityField.value = capacityField.value.replace(/,/g, '');
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            const lowerContainer = document.getElementById('lower-tour-form-container');
            if(lowerContainer) {
                lowerContainer.style.setProperty('display', 'none', 'important');
            }

            addVendorRow();

            const visualInput = document.getElementById("basePriceVisual");
            const actualInput = document.getElementById("basePriceActual");

            visualInput.addEventListener("input", function (e) {
                let value = this.value.replace(/[^0-9.]/g, '');
                
                const decimalCheck = value.split('.');
                if (decimalCheck.length > 2) {
                    value = decimalCheck[0] + '.' + decimalCheck.slice(1).join('');
                }

                let [integerPart, decimalPart] = value.split('.');
         
                if (integerPart) {
                    integerPart = parseInt(integerPart, 10).toLocaleString('en-US');
                }

                let formattedValue = integerPart || "";
                if (decimalPart !== undefined) {
                    formattedValue += '.' + decimalPart.slice(0, 2);
                }

                this.value = formattedValue;
                actualInput.value = value ? parseFloat(value) : '';
            });

            visualInput.addEventListener("blur", function () {
                const rawValue = parseFloat(actualInput.value);
                if (!isNaN(rawValue)) {
                    visualInput.value = rawValue.toLocaleString('en-US', {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    });
                }
            });
        });
    </script>
</body>
</html>
