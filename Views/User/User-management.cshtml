@model IEnumerable<_UPDATED__FrontEnd_Capstone.Models.User>
@using System.Text.Encodings.Web
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=1440, initial-scale=1.0">
    <title>J-Hub | Admin Access Control</title>
    <style>
        :root {
            --bg-primary: #0f172a; --bg-secondary: #1e293b; --border-color: #334155;
            --text-primary: #ffffff; --text-muted: #94a3b8; --accent-blue: #3b82f6; --status-nogo: #ef4444;
            --status-go: #22c55e;
        }
        body { margin: 0; padding: 0; box-sizing: border-box; background-color: var(--bg-primary); font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; color: var(--text-primary); }
        .dashboard-layout { display: grid; grid-template-columns: 250px 1fr; height: 100vh; overflow: hidden; }
        .sidebar { background-color: var(--bg-secondary); padding: 24px; border-right: 1px solid var(--border-color); display: flex; flex-direction: column; }
        .main-content { padding: 32px; overflow-y: auto; background-color: var(--bg-primary); }
        .data-table { width: 100%; border-collapse: collapse; background-color: var(--bg-secondary); border-radius: 8px; overflow: hidden; }
        .data-table th, .data-table td { text-align: left; padding: 16px; border-bottom: 1px solid var(--border-color); }
        .data-table th { background-color: rgba(0,0,0,0.2); font-size: 12px; letter-spacing: 0.05em; color: var(--text-muted); }
        .heading-xl { font-size: 28px; font-weight: 700; margin: 0; }
        .heading-md { font-size: 15px; font-weight: 600; margin: 0; }
        .heading-lg { font-size: 24px; font-weight: 700; margin: 0; }
        .body-text { font-size: 14px; line-height: 1.5; margin: 0; }
        .label-text { font-size: 12px; font-weight: 600; color: var(--text-muted); letter-spacing: 0.5px; }
        .brand-logo { display: flex; align-items: center; gap: 10px; margin-bottom: 32px; }
        .logo-text { font-size: 20px; font-weight: 800; color: #ffffff; }
        .btn { padding: 10px 20px; border-radius: 8px; font-size: 14px; font-weight: 600; cursor: pointer; border: none; transition: opacity 0.2s; }
        .btn-primary { background-color: #2563eb; color: white; }
        .btn-secondary { background-color: #475569; color: white; }
        .btn-info { background-color: #0284c7; color: white; }
        .btn-danger { background-color: var(--status-nogo); color: white; padding: 6px 12px; font-size: 12px; }
        .badge { padding: 4px 8px; border-radius: 4px; font-size: 12px; font-weight: 600; display: inline-block; }
        .bg-active { background-color: rgba(34, 197, 94, 0.2); color: var(--status-go); }
        .input-field { background-color: var(--bg-primary); border: 1px solid var(--border-color); color: var(--text-primary); padding: 10px 14px; border-radius: 6px; font-size: 14px; width: 100%; box-sizing: border-box; margin-top: 6px; }
        .modal-overlay { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(15, 23, 42, 0.85); z-index: 1000; justify-content: center; align-items: center; }
        .modal-card { background-color: var(--bg-secondary); padding: 32px; border-radius: 12px; border: 1px solid var(--border-color); width: 100%; max-width: 400px; }
        
        .details-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 20px; }
        .details-group { background-color: var(--bg-primary); padding: 12px; border-radius: 6px; border: 1px solid var(--border-color); }
        .details-val { font-size: 14px; font-weight: 500; margin-top: 4px; color: var(--text-primary); }
    </style>
</head>
<body>
    <div class="dashboard-layout">
        <aside class="sidebar">
            <div class="brand-logo">
                <span class="logo-text">J-Hub <span style="font-size: 14px; font-weight: 500; color: var(--text-muted); vertical-align: middle; margin-left: 4px;">Admin</span></span>
            </div>
            <nav style="display: flex; flex-direction: column; gap: 16px; height: 100%;">
                <a href="/Home/OperatorDashboard" class="body-text" style="color: var(--text-muted); text-decoration: none;">Dashboard</a>
                <a href="/Tour/Management" class="body-text" style="color: var(--text-muted); text-decoration: none;">Tour Management</a>
                <a href="/User/BookingQueue" class="body-text" style="color: var(--text-muted); text-decoration: none;">Booking Queue</a>
                <a href="/Tour/VendorManagement" class="body-text" style="color: var(--text-muted); text-decoration: none;">Vendors</a>
                <a href="/User/UserManagement" class="body-text" style="color: var(--text-primary); font-weight: 600; text-decoration: none;">User Management (RBAC)</a>
                <a href="/Home/Login" class="body-text" style="color: var(--status-nogo); text-decoration: none; font-weight: 500; margin-top: auto;">Log Out</a>
            </nav>
        </aside>

        <main class="main-content">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
                <h1 class="heading-xl">Admin Access Control</h1>
                <button onclick="document.getElementById('add-modal').style.display='flex'" class="btn btn-primary">+ Add New User</button>
            </div>
            
            <table class="data-table">
                <thead>
                    <tr>
                        <th class="label-text">NAME</th>
                        <th class="label-text">EMAIL</th>
                        <th class="label-text">ROLE</th>
                        <th class="label-text">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null) {
                        @foreach (var user in Model) {
                            <tr>
                                <td class="heading-md">@user.FullName</td>
                                <td class="body-text">@user.Email</td>
                                <td class="body-text">@user.Role</td>
                                <td>
                                    <div style="display: flex; gap: 8px; align-items: center;">
                                        <button class="btn btn-info" style="padding: 6px 12px; font-size: 12px;" onclick="openDetailsModal('@JavaScriptEncoder.Default.Encode(user.FullName)', '@JavaScriptEncoder.Default.Encode(user.Email)', '@JavaScriptEncoder.Default.Encode(user.PhoneNumber)', '@user.Sex', @user.Age, '@JavaScriptEncoder.Default.Encode(user.Role)', '@JavaScriptEncoder.Default.Encode(user.Status)')">View</button>
                                        
                                        <button class="btn btn-secondary" style="padding: 6px 12px; font-size: 12px;" onclick="openEditModal(@user.Id, '@JavaScriptEncoder.Default.Encode(user.FullName)', '@JavaScriptEncoder.Default.Encode(user.Email)', '@JavaScriptEncoder.Default.Encode(user.Role)')">Edit</button>
                                        
                                        <form action="/User/DeleteUser" method="POST" style="display:inline; margin: 0;" onsubmit="return confirm('Are you sure you want to remove this user from the security track?');">
                                            <input type="hidden" name="id" value="@user.Id">
                                            <button type="submit" class="btn btn-danger">Delete</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </main>
    </div>

    <div id="view-modal" class="modal-overlay">
        <div class="modal-card" style="max-width: 480px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 1px solid var(--border-color); padding-bottom: 12px;">
                <h2 class="heading-lg" id="view-title">User Account Track</h2>
                <span class="badge bg-active" id="view-status">Active</span>
            </div>
            
            <div class="details-grid">
                <div class="details-group" style="grid-column: span 2;">
                    <div class="label-text">EMAIL ADDRESS</div>
                    <div id="view-email" class="details-val"></div>
                </div>
                <div class="details-group">
                    <div class="label-text">CONTACT NUMBER</div>
                    <div id="view-phone" class="details-val"></div>
                </div>
                <div class="details-group">
                    <div class="label-text">SECURITY ACCESS ROLE</div>
                    <div id="view-role" class="details-val" style="color: var(--accent-blue); font-weight: 700; text-transform: uppercase;"></div>
                </div>
                <div class="details-group">
                    <div class="label-text">BIOLOGICAL SEX</div>
                    <div id="view-sex" class="details-val"></div>
                </div>
                <div class="details-group">
                    <div class="label-text">CURRENT AGE</div>
                    <div id="view-age" class="details-val"></div>
                </div>
            </div>

            <button type="button" onclick="document.getElementById('view-modal').style.display='none'" class="btn btn-secondary" style="width: 100%;">Close Panel</button>
        </div>
    </div>

    <!-- Edit User Modal -->
    <div id="edit-modal" class="modal-overlay">
        <div class="modal-card">
            <h2 class="heading-md" style="margin-bottom: 16px;">Edit User</h2>
            <form action="/User/EditUser" method="POST">
                <input type="hidden" name="id" id="edit-id">
                <input type="text" name="fullName" id="edit-name" class="input-field" required placeholder="Full Name">
                <input type="email" name="email" id="edit-email" class="input-field" required placeholder="Email">
            
               
                <select name="role" id="edit-role" class="input-field" required>
                    <option value="" disabled selected>Select Role...</option>
                    <option value="admin">admin</option>
                    <option value="operator">operator</option>
                </select>

                <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 16px;">Save Changes</button>
                <button type="button" onclick="document.getElementById('edit-modal').style.display='none'" class="btn" style="width: 100%; margin-top: 10px; background: transparent;">Cancel</button>
            </form>
        </div>
    </div>

    <!-- Add New User Modal -->
    <div id="add-modal" class="modal-overlay">
        <div class="modal-card">
            <h2 class="heading-md" style="margin-bottom: 16px;">Add New User</h2>
            <form action="/User/CreateUser" method="POST">
                <input type="text" name="fullName" placeholder="Full Name" class="input-field" required>
                <input type="email" name="email" placeholder="Email" class="input-field" required>
                <input type="text" name="phoneNumber" placeholder="Phone Number" class="input-field" required>
                <input type="text" name="sex" placeholder="Sex (Male/Female)" class="input-field" required>
                <input type="number" name="age" placeholder="Age" class="input-field" required>
                <input type="password" name="password" placeholder="Password" class="input-field" required>
                
                <!-- Pinalitan din ng select dropdown para sa Add form -->
                <select name="role" class="input-field" required>
                    <option value="" disabled selected>Select Role...</option>
                    <option value="admin">admin</option>
                    <option value="operator">operator</option>
                </select>

                <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 16px;">Create User</button>
                <button type="button" onclick="document.getElementById('add-modal').style.display='none'" class="btn" style="width: 100%; margin-top: 10px; background: transparent;">Cancel</button>
            </form>
        </div>
    </div>
    
    <script>
        function openDetailsModal(name, email, phone, sex, age, role, status) {
            document.getElementById('view-title').innerText = decodeURIComponent(name);
            document.getElementById('view-email').innerText = decodeURIComponent(email);
            document.getElementById('view-phone').innerText = decodeURIComponent(phone);
            document.getElementById('view-sex').innerText = sex;
            document.getElementById('view-age').innerText = age + " years old";
            document.getElementById('view-role').innerText = decodeURIComponent(role);
            document.getElementById('view-status').innerText = decodeURIComponent(status);
            
            document.getElementById('view-modal').style.display = 'flex';
        }

        function openEditModal(id, name, email, role) {
            document.getElementById('edit-id').value = id;
            document.getElementById('edit-name').value = decodeURIComponent(name);
            document.getElementById('edit-email').value = decodeURIComponent(email);
            document.getElementById('edit-role').value = decodeURIComponent(role).toLowerCase();
            document.getElementById('edit-modal').style.display = 'flex';
        }
    </script>
</body>
</html>
