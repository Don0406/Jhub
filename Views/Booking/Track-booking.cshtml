@model IEnumerable<_UPDATED__FrontEnd_Capstone.Models.Tour>
@{
    Layout = null;
}<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=1440, initial-scale=1.0">
    <title>J-Hub | Track Booking</title>
    <link rel="stylesheet" href="~/styles.css">
    <style>
        :root {
            --bg-primary: #0f172a;
            --bg-secondary: #1e293b;
            --border-color: #334155;
            --text-primary: #ffffff;
            --text-muted: #94a3b8;
            --accent-blue: #3b82f6;
            --status-go: #22c55e;
            --status-watch: #eab308;
            --status-danger: #ef4444;
        }

        body {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            background-color: var(--bg-primary);
            font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            color: var(--text-primary);
        }

        .nav-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 16px 40px;
            background-color: var(--bg-secondary);
            border-bottom: 1px solid var(--border-color);
        }

        .track-container {
            max-width: 500px;
            margin: 80px auto;
            padding: 32px;
            background-color: var(--bg-secondary);
            border-radius: 8px;
            border: 1px solid var(--border-color);
        }

        .input-group {
            margin-bottom: 20px;
        }

        .input-group label {
            display: block;
            margin-bottom: 8px;
            font-size: 14px;
            color: var(--text-muted);
        }

        .input-field {
            width: 100%;
            background-color: var(--bg-primary);
            border: 1px solid var(--border-color);
            color: white;
            padding: 12px 16px;
            border-radius: 6px;
            font-size: 14px;
            outline: none;
            box-sizing: border-box;
        }

        .input-field:focus {
            border-color: var(--accent-blue);
        }

        .btn {
            width: 100%;
            padding: 12px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            border: none;
        }

        .btn-primary { background-color: #2563eb; color: white; }
        .alert-danger { background-color: rgba(239, 68, 68, 0.1); border: 1px solid var(--status-danger); color: var(--status-danger); padding: 12px; border-radius: 6px; margin-bottom: 20px; font-size: 14px; }
    </style>
</head>
<body>

    <nav class="nav-top">
        <div class="brand-logo" style="display: flex; align-items: center; gap: 10px;">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--accent-blue)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                <line x1="12" y1="22.08" x2="12" y2="12"></line>
            </svg>
            <span class="logo-text" style="font-size: 20px; font-weight: 800;">J-Hub <span style="font-size: 14px; font-weight: 500; color: var(--text-muted); vertical-align: middle; margin-left: 4px;">Guest Portal</span></span>
        </div>
        
        <div style="display: flex; gap: 24px; align-items: center;">
            <a href="/Booking/Tour-discovery" style="color: var(--text-primary); text-decoration: none; font-weight: 500; font-size: 14px;">Discover Tours</a>
        </div>
    </nav>

    <div class="track-container">
        <h2 style="margin-top: 0; margin-bottom: 8px; font-size: 24px;">Track Booking Status</h2>
        <p style="color: var(--text-muted); font-size: 14px; margin-bottom: 24px;">Enter your transaction reference number and lead customer email to pull verification data.</p>

        @if (ViewBag.Error != null)
        {
            <div class="alert-danger">@ViewBag.Error</div>
        }

        <form method="post" action="/Booking/TrackStatus">
            <div class="input-group">
                <label for="ref-number">Reference Number</label>
                <input type="text" name="referenceNumber" id="ref-number" class="input-field" placeholder="e.g., JH-12345" required>
            </div>

            <div class="input-group">
                <label for="track-email">Lead Customer Email</label>
                <input type="email" name="email" id="track-email" class="input-field" placeholder="e.g., name@example.com" required>
            </div>

            <button type="submit" class="btn btn-primary">Verify & Track Status</button>
        </form>
    </div>

</body>
</html>
