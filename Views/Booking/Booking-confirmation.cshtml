@using System.Globalization
@model _UPDATED__FrontEnd_Capstone.Models.Tour
@{
    Layout = null;
    
    // Kunin ang tour instance mula sa ViewBag.Tour o Model
    var currentSelectedTourInstance = ViewBag.Tour as _UPDATED__FrontEnd_Capstone.Models.Tour;
    
    var finalReferenceNumber = ViewBag.ReferenceNumber as string ?? "JH-XXXXX";
    var finalTourTitleName = ViewBag.TourName as string ?? (currentSelectedTourInstance != null ? currentSelectedTourInstance.TourName : (Model != null ? Model.TourName : "Tour Package Selection"));
    
    // Direktang kunin ang BasePrice mula sa Model o ViewBag.Tour
    decimal displayBasePrice = 0;
    if (currentSelectedTourInstance != null)
    {
        displayBasePrice = currentSelectedTourInstance.BasePrice;
    }
    else if (Model != null)
    {
        displayBasePrice = Model.BasePrice;
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=1440, initial-scale=1.0">
    <title>J-Hub | Booking Confirmed</title>
    <link rel="stylesheet" href="~/styles.css">
    <style>
        :root {
            --bg-primary: #0f172a;
            --bg-secondary: #1e293b;
            --border-color: #334155;
            --text-primary: #ffffff;
            --text-muted: #94a3b8;
            --accent-blue: #3b82f6;
            --status-go: #22c55e;
            --status-watch: #eab308;
        }
        
        * {
            box-sizing: border-box;
        }

        body { 
            margin: 0; 
            padding: 0;
            background-color: var(--bg-primary) !important; 
            font-family: system-ui, -apple-system, sans-serif; 
            color: var(--text-primary); 
        }

        .confirmation-container { 
            display: flex; 
            align-items: center; 
            justify-content: center; 
            min-height: 100vh; 
            padding: 20px; 
            background-color: var(--bg-primary);
        }

        .confirmation-card { 
            background-color: var(--bg-secondary); 
            padding: 48px; 
            border-radius: 12px; 
            width: 100%; 
            max-width: 500px; 
            border: 1px solid var(--border-color); 
            text-align: center; 
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
        }

        .success-icon { 
            width: 64px; 
            height: 64px; 
            background-color: rgba(34, 197, 94, 0.1); 
            color: var(--status-go); 
            border-radius: 50%; 
            display: flex; 
            align-items: center; 
            justify-content: center; 
            margin: 0 auto 24px auto; 
        }

        .badge-pending { 
            background-color: rgba(234, 179, 8, 0.15); 
            color: var(--status-watch); 
            padding: 6px 16px; 
            border-radius: 6px; 
            font-size: 12px; 
            font-weight: 700; 
            display: inline-block; 
            margin-bottom: 24px;
            border: 1px solid rgba(234, 179, 8, 0.3);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .details-grid { 
            display: grid; 
            grid-template-columns: 1fr 1fr; 
            gap: 16px; 
            text-align: left; 
            background-color: var(--bg-primary); 
            padding: 24px; 
            border-radius: 8px; 
            margin-bottom: 32px; 
            border: 1px solid var(--border-color); 
        }

        .label-text { 
            font-size: 11px; 
            color: var(--text-muted); 
            font-weight: 700; 
            margin: 0 0 6px 0; 
            letter-spacing: 0.5px;
        }

        .body-text { 
            font-size: 15px; 
            margin: 0; 
            color: var(--text-primary);
        }

        .btn { 
            padding: 14px 32px; 
            border-radius: 8px; 
            font-size: 14px; 
            font-weight: 600; 
            cursor: pointer; 
            border: none; 
            text-decoration: none; 
            display: inline-block; 
            width: 100%;
            transition: background-color 0.2s ease;
        }

        .btn-primary { 
            background-color: #2563eb; 
            color: white; 
        }
        
        .btn-primary:hover {
            background-color: #1d4ed8;
        }
    </style>
</head>
<body>

    <div class="confirmation-container">
        <div class="confirmation-card">
            <div class="success-icon">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
            </div>
            
            <h1 style="margin: 0 0 8px 0; font-size: 24px; font-weight: 800;">Booking Submitted!</h1>
            <p class="body-text" style="color: var(--text-muted); margin-bottom: 16px;">Ref: <span id="confirm-ref-number" style="color: white; font-weight: 700;">@finalReferenceNumber</span></p>
            
            <div class="badge-pending">Pending Validation</div>

            <div class="details-grid">
                <div>
                    <p class="label-text">TOUR</p>
                    <p class="body-text" style="font-weight: 500;">@finalTourTitleName</p>
                </div>
                <div>
                    <p class="label-text">STATUS</p>
                    <p class="body-text" style="font-weight: 500; color: var(--status-watch);">In Escrow</p>
                </div>
                <div style="grid-column: span 2;">
                    <p class="label-text">TOTAL AMOUNT</p>
                    <p class="body-text" style="font-weight: 700; color: var(--accent-blue); font-size: 20px;">₱@displayBasePrice.ToString("N2", CultureInfo.InvariantCulture)</p>
                </div>
            </div>
            
            <div style="text-align: left; background: var(--bg-primary); padding: 20px; border-radius: 8px; margin-bottom: 24px; border: 1px solid var(--border-color);">
                <p class="label-text" style="margin-bottom: 12px;">UPLOAD PROOF OF PAYMENT</p>
                <form action="/Booking/UploadConfirmationPoP" method="post" enctype="multipart/form-data">
                    <input type="hidden" name="bookingId" value="@(ViewBag.BookingId ?? 0)" />
                    <input type="file" name="popFile" accept="image/*" required style="width: 100%; color: var(--text-muted); margin-bottom: 15px; font-size: 13px;" />
                    <button type="submit" class="btn" style="background-color: var(--status-go); color: white; border: none; width: 100%; padding: 12px; border-radius: 6px; font-weight: 600; cursor: pointer;">
                        Upload & Finalize
                    </button>
                </form>
            </div>

            <a href="/Booking/Tour-discovery" class="btn btn-primary">Return to Tour Catalog</a>
        </div>
    </div>

</body>
</html>
