@model _UPDATED__FrontEnd_Capstone.Models.Tour
@{
    Layout = null;
    var currentSelectedTourInstance = ViewBag.Tour as _UPDATED__FrontEnd_Capstone.Models.Tour;
    var baseTourPriceValue = currentSelectedTourInstance?.BasePrice ?? 0;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=1440, initial-scale=1.0">
    <title>J-Hub | Passenger Details</title>
    <link rel="stylesheet" href="~/styles.css">
    <style>
        :root { --bg-primary: #0f172a; --bg-secondary: #1e293b; --border-color: #334155; --text-primary: #ffffff; --text-muted: #94a3b8; --accent-blue: #3b82f6; --status-go: #22c55e; --heading-lg: 24px; }
        body { background-color: var(--bg-primary); font-family: system-ui, -apple-system, sans-serif; color: var(--text-primary); padding: 40px 20px; margin: 0; }
        .checkout-container { width: 100%; max-width: 800px; margin: 0 auto; }
        .form-panel { background-color: var(--bg-secondary); padding: 32px; border-radius: 8px; border: 1px solid var(--border-color); margin-bottom: 24px; }
        .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 16px; }
        .input-field { background-color: #0f172a; border: 1px solid var(--border-color); color: white; padding: 10px 14px; border-radius: 6px; font-size: 14px; width: 100%; box-sizing: border-box; outline: none; }
        .label-text { font-size: 13px; color: var(--text-muted); font-weight: 600; display: block; margin-bottom: 6px; }
        .btn { padding: 10px 20px; border-radius: 8px; font-size: 14px; font-weight: 600; cursor: pointer; border: none; }
        .btn-primary { background-color: #2563eb; color: white; text-decoration: none; }
        .btn-secondary { background-color: #475569; color: white; }
        .heading-xl { font-size: 32px; font-weight: 800; margin: 0; }
        .heading-lg { font-size: var(--heading-lg); font-weight: 700; margin: 0; }
        .heading-md { font-size: 18px; font-weight: 600; margin: 0; }
        .body-text { font-size: 15px; margin: 0; }
        .body-sm { font-size: 13px; color: var(--text-muted); margin: 0; }
        .companion-row { display: flex; gap: 16px; align-items: center; margin-bottom: 12px; background: rgba(15,23,42,0.4); padding: 12px; border-radius: 6px; border: 1px solid var(--border-color); }
    </style>
</head>
<body>
    <div class="checkout-container">
        <h1 class="heading-xl" style="margin-bottom: 8px;">Passenger Details</h1>
        <p class="body-text" style="color: var(--text-muted); margin-bottom: 32px;">Provide details for the manifest structure setup for <strong>@currentSelectedTourInstance?.TourName</strong>.</p>

        <form action="/Booking/SubmitBooking" method="post" id="main-billing-manifest-form">
            <input type="hidden" name="tourId" value="@currentSelectedTourInstance?.Id" />
            <input type="hidden" name="totalAmount" id="hidden-total-field" value="@baseTourPriceValue" />
            <input type="hidden" name="companionNames" id="hidden-companions-field" value="" />
            <input type="hidden" name="slots" id="slots-pure" value="1">

            <div class="form-panel">
                <h3 class="heading-md" style="margin-bottom: 16px;">1. Lead Contact Information</h3>
                <div class="form-grid">
                    <div>
                        <label class="label-text">Full Name</label>
                        <input type="text" name="leadName" class="input-field" required>
                    </div>
                    <div>
                        <label class="label-text">Age</label>
                        <input type="number" name="leadAge" class="input-field" required>
                    </div>
                    <div>
                        <label class="label-text">Email Address</label>
                        <input type="email" name="leadEmail" class="input-field" required>
                    </div>
                    <div>
                        <label class="label-text">Mobile Number</label>
                        <input type="tel" name="leadPhone" class="input-field" placeholder="09XX XXX XXXX" required>
                    </div>
                    <div>
                        <label class="label-text">Number of Slots Requested (Pax)</label>
                        <input type="text" id="slots-masked" class="input-field" value="1" required style="text-align: left;">
                    </div>
                    <div>
                        <label class="label-text">Special Category (Applies to Lead Passenger)</label>
                        <select name="specialCategory" id="lead-category" class="input-field" onchange="runSubtotalRecomputationEngine()">
                            <option value="none">None (Regular)</option>
                            <option value="senior">Senior Citizen (20% Off Lead Base)</option>
                            <option value="pwd">PWD (20% Off Lead Base)</option>
                            <option value="minor">Student/Minor (10% Off Lead Base)</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="form-panel">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                    <h3 class="heading-md">2. Companion Details</h3>
                    <button type="button" class="btn btn-secondary" style="padding: 6px 12px; font-size: 14px;" onclick="injectCompanionInputField()">+ Add Companion</button>
                </div>
                <div id="companion-container"></div>
            </div>

            <div style="background-color: rgba(59, 130, 246, 0.05); padding: 24px; border-radius: 8px; margin-top: 32px; border: 1px dashed var(--accent-blue);">
                <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                    <span class="body-text">Base Tour Package Fee (Per Pax)</span>
                    <span class="heading-md">@baseTourPriceValue.ToString("C2")</span>
                </div>
                <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                    <span class="body-text">Total Slots Registered</span>
                    <span class="heading-md" id="summary-slots-display">1 pax</span>
                </div>
                <div style="display: flex; justify-content: space-between; margin-bottom: 8px; color: var(--status-go); display: none;" id="discount-row">
                    <span class="body-text" id="discount-label-text">Discount</span>
                    <span class="heading-md" id="summary-discount">- ₱0.00</span>
                </div>
                <hr style="border: none; border-top: 1px solid var(--border-color); margin: 16px 0;">
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <span class="heading-md">Total Amount Due</span>
                    <span class="heading-lg" id="summary-total" style="color: var(--accent-blue);">@baseTourPriceValue.ToString("C2")</span>
                </div>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 32px; margin-bottom: 64px;">
                <a href="/Booking/Details?id=@currentSelectedTourInstance?.Id" style="color: var(--text-muted); text-decoration: none;">← Back to Tour Details</a>
                <button type="submit" class="btn btn-primary" style="padding: 14px 40px; font-size: 16px;" onclick="collateCompanionsBeforePosting()">Proceed to Payment Verification →</button>
            </div>
        </form>
    </div>

    <script>
        const initialCostPerPax = parseFloat('@baseTourPriceValue');
        const slotsMasked = document.getElementById('slots-masked');
        const slotsPure = document.getElementById('slots-pure');

        slotsMasked.addEventListener('input', function(e) {
            let value = e.target.value.replace(/[^0-9]/g, '');
            let pureInt = parseInt(value) || 0;
            slotsPure.value = pureInt;
            e.target.value = value.replace(/\B(?=(\d{3})+(?!\d))/g, ",");
            runSubtotalRecomputationEngine();
        });

        slotsMasked.addEventListener('blur', function(e) {
            let pureInt = parseInt(slotsPure.value) || 1;
            if (pureInt < 1) pureInt = 1;
            slotsPure.value = pureInt;
            slotsMasked.value = pureInt.toLocaleString('en-US');
            runSubtotalRecomputationEngine();
        });

        function injectCompanionInputField() {
            const wrapper = document.getElementById('companion-container');
            const maxSlots = parseInt(slotsPure.value) || 1;
            const currentCount = wrapper.children.length + 1; // +1 for lead

            if (currentCount >= maxSlots) {
                alert('Companion count already matches your booked slots. Increase total slots first.');
                return;
            }

            const element = document.createElement('div');
            element.className = 'companion-row';
            element.innerHTML = `
                <input type="text" class="input-field companion-name-input" placeholder="Companion Full Name" required style="flex: 1;">
                <button type="button" class="btn" style="background:#ef4444; color:white; padding: 10px;" onclick="removeCompanionNode(this)">Remove</button>
            `;
            wrapper.appendChild(element);
            incrementSlotsCounter(1);
        }

        function removeCompanionNode(button) {
            button.parentElement.remove();
            incrementSlotsCounter(-1);
        }

        function incrementSlotsCounter(amount) {
            let currentSlots = parseInt(slotsPure.value) || 1;
            currentSlots = Math.max(1, currentSlots + amount);
            slotsPure.value = currentSlots;
            slotsMasked.value = currentSlots.toLocaleString('en-US');
            runSubtotalRecomputationEngine();
        }

        function formatMoney(val) {
            return '₱' + val.toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        function runSubtotalRecomputationEngine() {
            const drop = document.getElementById('lead-category').value;
            const row = document.getElementById('discount-row');
            const totalSlotsCount = parseInt(slotsPure.value) || 1;

            const grossTotalPackageCost = initialCostPerPax * totalSlotsCount;
            let reductionRate = 0;
            if (drop === 'senior' || drop === 'pwd') reductionRate = 0.20;
            else if (drop === 'minor') reductionRate = 0.10;

            document.getElementById('summary-slots-display').innerText =
                `${totalSlotsCount.toLocaleString('en-US')} pax`;

            if (reductionRate > 0) {
                const totalDiscountValue = initialCostPerPax * reductionRate;
                const netAmount = grossTotalPackageCost - totalDiscountValue;

                document.getElementById('discount-label-text').innerText =
                    `Special Category Discount (${reductionRate * 100}% off Lead Passenger)`;
                document.getElementById('summary-discount').innerText =
                    '- ' + formatMoney(totalDiscountValue);
                document.getElementById('summary-total').innerText = formatMoney(netAmount);
                document.getElementById('hidden-total-field').value = netAmount.toFixed(2);
                row.style.display = 'flex';
            } else {
                document.getElementById('summary-total').innerText = formatMoney(grossTotalPackageCost);
                document.getElementById('hidden-total-field').value = grossTotalPackageCost.toFixed(2);
                row.style.display = 'none';
            }
        }

        function collateCompanionsBeforePosting() {
            const names = Array.from(document.querySelectorAll('.companion-name-input'))
                .map(i => i.value.trim())
                .filter(Boolean);
            document.getElementById('hidden-companions-field').value = names.join(', ');
        }
    </script>
</body>
</html>
